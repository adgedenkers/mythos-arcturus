#!/usr/bin/env python3
"""
mythos-handoff — Generate a handoff payload for a subsystem.

Usage:
    mythos-handoff <subsystem>           # assemble, copy to clipboard
    mythos-handoff <subsystem> --stdout  # write to stdout instead
    mythos-handoff <subsystem> --file F  # write to file
    mythos-handoff --list                # list available subsystems

Reads:
    /opt/mythos/docs/<subsystem>/MANIFEST.yaml

Writes:
    clipboard (via xclip), or stdout, or file

The payload includes:
    - SESSION CONTEXT header
    - each include_docs file, wrapped in === DOC: path ===
    - each sql_queries result, wrapped in === SQL: name ===
    - validation results with PASS/FAIL banner
    - integrity state (if configured)
    - stream counters (live, from STREAMS.json)

Soft-warning validation: failures produce a big banner at the top
of the payload but do NOT block clipboard copy. Information over
restriction.

See docs/WORKFLOW.md for the full loop.
"""
import sys
import os
import subprocess
import argparse
import json
from pathlib import Path

try:
    import yaml
except ImportError:
    print("error: PyYAML not installed. Run: /opt/mythos/.venv/bin/pip install pyyaml",
          file=sys.stderr)
    sys.exit(2)

DOCS = Path("/opt/mythos/docs")
STREAMS_JSON = DOCS / "STREAMS.json"


def psql(sql: str, expanded: bool = False):
    """Run SQL via sudo -u postgres psql against mythos DB. Returns (rc, out, err)."""
    args = ['sudo', '-u', 'postgres', 'psql', '-d', 'mythos']
    if expanded:
        args.append('-x')
    args += ['-c', sql] if not sql.strip().startswith('\\') else ['-c', sql]
    r = subprocess.run(args, capture_output=True, text=True)
    return r.returncode, r.stdout, r.stderr


def psql_tA(sql: str):
    """Tuple-mode, no header, for programmatic comparison."""
    r = subprocess.run(
        ['sudo', '-u', 'postgres', 'psql', '-d', 'mythos', '-tAc', sql],
        capture_output=True, text=True,
    )
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def load_manifest(subsystem: str) -> dict:
    path = DOCS / subsystem / "MANIFEST.yaml"
    if not path.exists():
        print(f"error: manifest not found: {path}", file=sys.stderr)
        sys.exit(1)
    with open(path) as f:
        return yaml.safe_load(f)


def list_subsystems():
    if not DOCS.exists():
        return []
    out = []
    for p in sorted(DOCS.iterdir()):
        if p.is_dir() and (p / "MANIFEST.yaml").exists():
            out.append(p.name)
    return out


def section(title: str) -> str:
    return f"\n=== {title} ===\n"


def assemble(manifest: dict) -> tuple[str, list[str]]:
    """Build the full handoff payload. Returns (text, failed_validations)."""
    parts = []
    failed = []

    # Header
    name = manifest.get('display_name', manifest.get('subsystem', 'unknown'))
    stream = manifest.get('stream', '?')
    parts.append(f"=== SESSION CONTEXT ===")
    parts.append(f"Subsystem: {name}")
    parts.append(f"Primary stream: {stream}")
    parts.append(f"Generated by: mythos-handoff")
    parts.append(f"Manifest: docs/{manifest['subsystem']}/MANIFEST.yaml")

    if 'task' in manifest:
        parts.append(f"\nTask: {manifest['task']}")

    # Run validations FIRST so we can put the banner at top
    validations = manifest.get('validations', []) or []
    validation_results = []
    for v in validations:
        vname = v.get('name', '<unnamed>')
        sql = v.get('sql', '')
        expect = v.get('expect')
        expect_notice = v.get('expect_notice')

        rc, out, err = psql_tA(sql)
        ok = False
        detail = ''

        if expect_notice is not None:
            combined = (out + ' ' + err).upper()
            ok = expect_notice.upper() in combined
            detail = f"expected NOTICE {expect_notice!r}, got stdout={out!r} stderr={err!r}"
        elif expect is not None:
            ok = (out == str(expect))
            detail = f"expected {expect!r}, got {out!r}"
        else:
            ok = (rc == 0)
            detail = f"rc={rc} stdout={out!r} stderr={err!r}"

        validation_results.append((vname, ok, detail))
        if not ok:
            failed.append(vname)

    # Validation banner at top
    if validations:
        parts.append("")
        if failed:
            parts.append("⚠⚠⚠ VALIDATION FAILURES ⚠⚠⚠")
            for f in failed:
                parts.append(f"  ✗ {f}")
            parts.append("Foundation is NOT clean. Proceed with caution.")
        else:
            parts.append(f"✓ All {len(validations)} validations passed.")

    # Docs
    for doc_rel in manifest.get('include_docs', []) or []:
        doc_path = Path('/opt/mythos') / doc_rel if not doc_rel.startswith('/') else Path(doc_rel)
        parts.append(section(f"DOC: {doc_rel}"))
        if doc_path.exists():
            parts.append(doc_path.read_text())
        else:
            parts.append(f"(file not found: {doc_path})")

    # SQL queries
    for q in manifest.get('sql_queries', []) or []:
        qname = q.get('name', '<unnamed>')
        sql = q.get('sql', '')
        parts.append(section(f"SQL: {qname}"))
        parts.append(f"-- {sql}")
        rc, out, err = psql(sql)
        if rc == 0:
            parts.append(out.rstrip())
        else:
            parts.append(f"ERROR rc={rc}: {err.strip()}")

    # Validation detail block
    if validations:
        parts.append(section("VALIDATIONS (detail)"))
        for vname, ok, detail in validation_results:
            mark = "✓" if ok else "✗"
            parts.append(f"{mark} {vname}")
            if not ok:
                parts.append(f"    {detail}")

    # Stream counters
    streams = manifest.get('streams', []) or []
    if streams and STREAMS_JSON.exists():
        parts.append(section("STREAM COUNTERS"))
        try:
            data = json.loads(STREAMS_JSON.read_text())
            for s in streams:
                for key, val in data.get('streams', {}).items():
                    prefix = val.get('prefix', '').upper()
                    if prefix == s.upper() or key.upper() == s.upper():
                        parts.append(f"{prefix}: next_patch = {val.get('next_patch')}  "
                                     f"active_work = {val.get('active_work', '—')}")
        except Exception as e:
            parts.append(f"(STREAMS.json read failed: {e})")

    # Integrity state (if configured and live)
    integ = manifest.get('integrity') or {}
    if integ.get('filter_schema'):
        parts.append(section(f"INTEGRITY: schema={integ['filter_schema']}"))
        sql = (
            f"SELECT relname FROM pg_class c "
            f"JOIN pg_namespace n ON n.oid = c.relnamespace "
            f"WHERE n.nspname = '{integ['filter_schema']}' AND c.relkind = 'r' "
            f"ORDER BY relname;"
        )
        rc, out, err = psql(sql)
        parts.append(out.rstrip() if rc == 0 else f"(query failed: {err.strip()})")

    # Footer
    parts.append(section("END HANDOFF PAYLOAD"))
    parts.append(
        "Paste this entire block as the first message of a new Claude "
        "conversation. Claude has everything it needs to continue the work.\n"
    )

    return "\n".join(parts), failed


def main():
    ap = argparse.ArgumentParser(description="Mythos handoff payload generator")
    ap.add_argument('subsystem', nargs='?', help='subsystem name (e.g., finance)')
    ap.add_argument('--list', action='store_true', help='list available subsystems')
    ap.add_argument('--stdout', action='store_true', help='write to stdout instead of clipboard')
    ap.add_argument('--file', help='write to file instead of clipboard')
    ap.add_argument('--strict', action='store_true',
                    help='exit 1 on validation failure (default: soft warning, exit 0)')
    args = ap.parse_args()

    if args.list:
        subs = list_subsystems()
        if not subs:
            print("(no subsystems with MANIFEST.yaml found under /opt/mythos/docs/)")
        else:
            print("Available subsystems:")
            for s in subs:
                print(f"  {s}")
        sys.exit(0)

    if not args.subsystem:
        ap.print_help()
        sys.exit(2)

    manifest = load_manifest(args.subsystem)
    manifest.setdefault('subsystem', args.subsystem)
    text, failed = assemble(manifest)

    if args.file:
        Path(args.file).write_text(text)
        print(f"✓ handoff written to {args.file} ({len(text)} bytes)", file=sys.stderr)
    elif args.stdout:
        sys.stdout.write(text)
    else:
        try:
            p = subprocess.run(
                ['xclip', '-selection', 'clipboard'],
                input=text, text=True, check=True,
            )
            print(f"✓ handoff copied to clipboard ({len(text)} bytes, "
                  f"{len(text.splitlines())} lines)", file=sys.stderr)
        except FileNotFoundError:
            print("error: xclip not installed. Use --stdout or --file.", file=sys.stderr)
            sys.exit(2)

    if failed:
        print(f"⚠ {len(failed)} validation(s) FAILED — banner is at top of payload",
              file=sys.stderr)
        for f in failed:
            print(f"  ✗ {f}", file=sys.stderr)
        if args.strict:
            # SYS-0080: strict mode for programmatic callers
            sys.exit(1)
        # Default: soft warning, exit 0 so interactive use isn't broken
    sys.exit(0)


if __name__ == '__main__':
    main()
