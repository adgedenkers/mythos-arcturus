        ok "Session journals: ${journal_count} in ~/.mx/journal/"
    fi
}

block_summary() {
    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo -e "${BOLD}╔══════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}║   MYTHOS SYSTEM SUMMARY              ║${RESET}"
    echo -e "${BOLD}║   $ts          ║${RESET}"
    echo -e "${BOLD}╚══════════════════════════════════════╝${RESET}"

    block_services
    block_db
    block_patches
}

show_help() {
    echo -e "${BOLD}mythos-diag${RESET} — Arcturus system diagnostic tool"
    echo ""
    echo -e "${BOLD}Usage:${RESET}"
    echo "  mythos-diag              Full summary (services + db + patches)"
    echo "  mythos-diag services     All mythos-* service states"
    echo "  mythos-diag workers      Worker service states"
    echo "  mythos-diag db           PostgreSQL + Neo4j + Redis"
    echo "  mythos-diag hw           Disk, RAM, GPU, uptime"
    echo "  mythos-diag patches      Version, stream counters, recent patches"
    echo "  mythos-diag streams      Stream ownership + next patch counters"
    echo "  mythos-diag redis        Redis keyspace detail"
  echo "  mythos-diag mx           mx shell session status"
  echo "  mythos-diag mx           mx shell session status"
  echo "  mythos-diag mx           mx shell session status"
    echo "  mythos-diag all          Everything"
    echo "  mythos-diag help         This help"
    echo ""
    echo -e "${DIM}Tip: combine blocks — mythos-diag services db${RESET}"
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

ARGS=("${@:-}")

if [[ ${#ARGS[@]} -eq 0 ]] || [[ "${ARGS[0]}" == "" ]]; then
    block_summary
    exit 0
fi

if [[ "${ARGS[0]}" == "help" || "${ARGS[0]}" == "--help" || "${ARGS[0]}" == "-h" ]]; then
    show_help
    exit 0
fi

if [[ "${ARGS[0]}" == "all" ]]; then
    block_summary
    block_workers
    block_hw
    block_redis
    block_mx
    block_mx
    block_mx
    exit 0
fi

for arg in "${ARGS[@]}"; do
    case "$arg" in
        services)  block_services ;;
        workers)   block_workers ;;
        db)        block_db ;;
        hw)        block_hw ;;
        patches)   block_patches ;;
        streams)   block_streams ;;
        redis)     block_redis ;;
        mx)        block_mx ;;
        mx)        block_mx ;;
        mx)        block_mx ;;
        summary)   block_summary ;;
        *)         warn "Unknown block: $arg (run 'mythos-diag help')" ;;
    esac
done

echo ""
