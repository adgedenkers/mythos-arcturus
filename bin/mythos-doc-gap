#!/opt/mythos/.venv/bin/python3
"""
mythos-doc-gap — Push documentation gap items to Iris doc worker queues.

Takes the gap analysis from the March 7-8 build push and creates
properly formatted tasks for each undocumented component, pushing
them to the existing iris:docs:queue:{type} Redis lists.

Usage:
    mythos-doc-gap --list              Show all gap items and their queue targets
    mythos-doc-gap --push              Push all gap items to Redis queues
    mythos-doc-gap --push --item N     Push a single item by number
    mythos-doc-gap --push --dry-run    Show what would be pushed without pushing
    mythos-doc-gap --status            Show current doc worker queue depths
    mythos-doc-gap --run               Push all items AND run iris-docworker --run-once
    mythos-doc-gap --clear-dedup       Clear the dedup set (allows re-pushing)
"""

import argparse
import json
import hashlib
import logging
import os
import subprocess
import sys
import time

sys.path.insert(0, "/opt/mythos")

# Load env
env_file = "/opt/mythos/.env"
if os.path.exists(env_file):
    with open(env_file) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, _, val = line.partition("=")
                os.environ.setdefault(key.strip(), val.strip())

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [doc-gap] %(levelname)s: %(message)s",
)
logger = logging.getLogger("doc-gap")


