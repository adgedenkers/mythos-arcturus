# ═══════════════════════════════════════════════════
# QUEUE OPERATIONS
# ═══════════════════════════════════════════════════

QUEUE_MAP = {
    "component": "iris:docs:queue:component",
    "architecture": "iris:docs:queue:architecture",
    "system_map": "iris:docs:queue:system_map",
}

DEDUP_KEY = "iris:docs:dedup"


def task_hash(task):
    return hashlib.sha256(json.dumps(task, sort_keys=True).encode()).hexdigest()[:16]


def build_task(item):
    """Convert a gap item into the task format the doc worker expects."""
    queue_type = item["queue"]

    if queue_type == "component":
        return {
            "type": "component_doc",
            "component": item["component"],
            "file_count": len(item.get("files", [])),
            "files": item.get("files", []),
            "component_summary": item.get("purpose", ""),
            "documentation_gaps": [f"New component from March 7-8 build push — not yet documented"],
            "status": "pending",
            "created_at": time.time(),
        }
    elif queue_type == "architecture":
        return {
            "type": "architecture_entry",
            "component": item["component"],
            "file_count": len(item.get("files", [])),
            "files": item.get("files", []),
            "purpose": item.get("purpose", ""),
            "status": "pending",
            "created_at": time.time(),
        }
    elif queue_type == "system_map":
        return {
            "type": "system_map",
            "components": item.get("components", []),
            "total_files": 0,
            "purpose": item.get("purpose", ""),
            "status": "pending",
            "created_at": time.time(),
        }
    else:
        raise ValueError(f"Unknown queue type: {queue_type}")


def push_item(r, item, dry_run=False):
    """Push a single gap item to the appropriate Redis queue."""
    queue_type = item["queue"]
    queue_key = QUEUE_MAP.get(queue_type)
    if not queue_key:
        logger.error(f"No queue for type '{queue_type}'")
        return False

    task = build_task(item)
    th = task_hash(task)

    if r.sismember(DEDUP_KEY, th):
        logger.info(f"  [{item['id']:2d}] {item['component']:<30s} SKIPPED (dedup)")
        return False

    if dry_run:
        logger.info(f"  [{item['id']:2d}] {item['component']:<30s} → {queue_key} (DRY RUN)")
        return True

    r.sadd(DEDUP_KEY, th)
    r.rpush(queue_key, json.dumps(task))
    logger.info(f"  [{item['id']:2d}] {item['component']:<30s} → {queue_key}")
    return True


# ═══════════════════════════════════════════════════
# COMMANDS
# ═══════════════════════════════════════════════════

def cmd_list():
    """Show all gap items."""
    print(f"\n{'#':>3s}  {'Queue':<15s}  {'Component':<30s}  {'Files':>5s}")
    print("-" * 60)
    for item in GAP_ITEMS:
        print(f"{item['id']:3d}  {item['queue']:<15s}  {item['component']:<30s}  {len(item.get('files', [])):5d}")
    print(f"\nTotal: {len(GAP_ITEMS)} items")
    print(f"  architecture: {sum(1 for i in GAP_ITEMS if i['queue'] == 'architecture')}")
    print(f"  component:    {sum(1 for i in GAP_ITEMS if i['queue'] == 'component')}")
    print(f"  system_map:   {sum(1 for i in GAP_ITEMS if i['queue'] == 'system_map')}")


def cmd_push(item_id=None, dry_run=False):
    """Push gap items to Redis queues."""
    import redis as redis_lib
    r = redis_lib.Redis(host="localhost", port=6379, decode_responses=True)

    items = GAP_ITEMS
    if item_id is not None:
        items = [i for i in GAP_ITEMS if i["id"] == item_id]
        if not items:
            print(f"No item with id {item_id}")
            return

    pushed = 0
    skipped = 0
    for item in items:
        if push_item(r, item, dry_run=dry_run):
            pushed += 1
        else:
            skipped += 1

    action = "Would push" if dry_run else "Pushed"
    print(f"\n{action}: {pushed}  |  Skipped (dedup): {skipped}")
    r.close()


def cmd_status():
    """Show queue depths."""
    import redis as redis_lib
    r = redis_lib.Redis(host="localhost", port=6379, decode_responses=True)

    print("\nDoc Worker Queue Status:")
    print("-" * 45)
    for name, key in QUEUE_MAP.items():
        pending = r.llen(key)
        print(f"  {name:<15s}  {pending:>3d} pending")

    processing = r.scard("iris:docs:processing")
    completed = r.zcard("iris:docs:completed")
    dedup = r.scard(DEDUP_KEY)
    print(f"\n  processing:    {processing}")
    print(f"  completed:     {completed}")
    print(f"  dedup set:     {dedup}")
    r.close()


def cmd_run(item_id=None, dry_run=False):
    """Push items then run the doc worker."""
    cmd_push(item_id=item_id, dry_run=dry_run)
    if not dry_run:
        print("\nStarting iris-docworker --run-once...")
        subprocess.run(
            ["/opt/mythos/.venv/bin/python3", "/opt/mythos/bin/iris-docworker", "--run-once"],
            cwd="/opt/mythos",
        )


def cmd_clear_dedup():
    """Clear the dedup set to allow re-pushing."""
    import redis as redis_lib
    r = redis_lib.Redis(host="localhost", port=6379, decode_responses=True)
    count = r.scard(DEDUP_KEY)
    r.delete(DEDUP_KEY)
    print(f"Cleared dedup set ({count} entries)")
    r.close()


def main():
    parser = argparse.ArgumentParser(description="Push documentation gap items to Iris doc worker")
    parser.add_argument("--list", action="store_true", help="Show all gap items")
    parser.add_argument("--push", action="store_true", help="Push items to Redis queues")
    parser.add_argument("--run", action="store_true", help="Push + run iris-docworker")
    parser.add_argument("--status", action="store_true", help="Show queue depths")
    parser.add_argument("--item", type=int, help="Process a single item by ID")
    parser.add_argument("--dry-run", action="store_true", help="Preview without pushing")
    parser.add_argument("--clear-dedup", action="store_true", help="Clear dedup set")
    args = parser.parse_args()

    if args.clear_dedup:
        cmd_clear_dedup()
    elif args.list:
        cmd_list()
    elif args.status:
        cmd_status()
    elif args.push:
        cmd_push(item_id=args.item, dry_run=args.dry_run)
    elif args.run:
        cmd_run(item_id=args.item, dry_run=args.dry_run)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
