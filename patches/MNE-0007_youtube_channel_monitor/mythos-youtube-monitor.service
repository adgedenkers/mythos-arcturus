[Unit]
Description=Mythos YouTube Channel Monitor
After=network.target postgresql.service

[Service]
Type=simple
User=adge
Group=adge
WorkingDirectory=/opt/mythos
Environment="PATH=/opt/mythos/.venv/bin:/usr/local/bin:/usr/bin"
ExecStart=/opt/mythos/.venv/bin/python3 /opt/mythos/workers/youtube_channel_monitor.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
