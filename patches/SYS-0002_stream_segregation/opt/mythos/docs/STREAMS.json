    "bot_registration": "New /commands register through SYS patches; handler code lives in the originating stream"
  },

  "ambiguous_items": [
    {
      "item": "checkin_handler.py",
      "candidates": ["NEU", "SEN"],
      "reason": "Check-ins are both a sensory/environmental log (SEN) and feed into consciousness state (NEU). Currently assigned to SEN as primary owner since it's environmental input, but NEU reads its output."
    },
    {
      "item": "overview.py / smart_overview.py (API routes)",
      "candidates": ["SEN", "SYS"],
      "reason": "Overview pulls calendar, weather, financial pulse — cross-stream aggregation. Assigned to SEN because it primarily surfaces environmental/temporal awareness, but touches SYS finance data."
    },
    {
      "item": "perception_log table",
      "candidates": ["NEU", "SEN"],
      "reason": "Perception is the boundary between sensory input (SEN) and conscious processing (NEU). Assigned to NEU as it's the output of the perception pipeline, not the raw input."
    },
    {
      "item": "orchestrator/ and orchestration/ directories",
      "candidates": ["LOG", "SYS"],
      "reason": "The orchestrator is reasoning/model-routing infrastructure (LOG territory) but it's also foundational plumbing. Assigned to LOG since it governs LLM reasoning pipelines."
    },
    {
      "item": "workers/ directory",
      "candidates": ["MNE", "SYS"],
      "reason": "Workers process conversations and memory pipelines — core MNE work — but the worker framework itself is infrastructure. Assigned to MNE since the workers are primarily memory/conversation processors."
    },
    {
      "item": "triad/ directory",
      "candidates": ["LOG", "NEU"],
      "reason": "The Triad (Ka'tuar'el / Seraphe / Iris relational prompts) is identity/language (LOG) but also feeds NEU consciousness state. Assigned to LOG as it's prompt/language infrastructure."
    },
    {
      "item": "integrity/ directory + Integrity* Neo4j labels",
      "candidates": ["SYS", "LOG"],
      "reason": "Integrity scanning is system health (SYS) but produces knowledge graph output (LOG labels). Assigned to SYS since it's operational infrastructure."
    },
    {
      "item": "spend analytics (spending_analytics.py)",
      "candidates": ["SYS", "SEN"],
      "reason": "Spending analytics is financial data (SYS owns finance) but surfaces as an awareness layer. Assigned to SEN as a temporal/environmental awareness report."
    }
