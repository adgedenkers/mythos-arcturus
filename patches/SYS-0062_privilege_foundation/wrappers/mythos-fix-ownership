#!/bin/bash
# /usr/local/libexec/mythos/mythos-fix-ownership
# Recursive chown /opt/mythos to adge:adge. Recovery operation for cases
# where legacy patch framework bugs left root-owned files.
# Installed by SYS-0062.

set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "usage: mythos-fix-ownership (no arguments)" >&2
    exit 2
fi

TARGET="/opt/mythos"

if [[ ! -d "$TARGET" ]]; then
    echo "error: $TARGET does not exist" >&2
    exit 2
fi

# Signature file check — don't chown something that isn't Mythos
for sig in "$TARGET/patches/scripts/patch_base.py" "$TARGET/docs/STREAMS.json" "$TARGET/.env"; do
    if [[ ! -f "$sig" ]]; then
        echo "error: signature file missing: $sig — not a Mythos tree" >&2
        exit 2
    fi
done

/bin/chown -R adge:adge "$TARGET/"

echo "chowned: $TARGET/ to adge:adge"
