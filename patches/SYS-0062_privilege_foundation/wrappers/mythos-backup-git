#!/bin/bash
# /usr/local/libexec/mythos/mythos-backup-git
# Create a timestamped tar.gz of /opt/mythos/.git in /tmp/.
# Outputs the resulting path to stdout.
# Installed by SYS-0062.

set -euo pipefail

# Tight default permissions on created files
umask 077

if [[ $# -ne 0 ]]; then
    echo "usage: mythos-backup-git (no arguments)" >&2
    exit 2
fi

if [[ ! -d "/opt/mythos/.git" ]]; then
    echo "error: /opt/mythos/.git does not exist" >&2
    exit 2
fi

TIMESTAMP=$(/bin/date +%Y%m%d_%H%M%S)
BACKUP_PATH="/tmp/mythos_git_backup_${TIMESTAMP}.tar.gz"

/bin/tar czf "$BACKUP_PATH" -C /opt/mythos .git

echo "$BACKUP_PATH"
