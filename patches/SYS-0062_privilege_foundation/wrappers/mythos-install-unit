#!/bin/bash
# /usr/local/libexec/mythos/mythos-install-unit
# Deploy a systemd unit file from /opt/mythos/systemd/ to /etc/systemd/system/.
# Installed by SYS-0062.

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: mythos-install-unit <basename.service|basename.timer>" >&2
    exit 2
fi

UNIT_BASENAME="$1"

# Basename only — reject any path component
if [[ "$UNIT_BASENAME" == */* ]]; then
    echo "error: basename only, no paths: $UNIT_BASENAME" >&2
    exit 2
fi

# Reject shell metacharacters
if [[ "$UNIT_BASENAME" =~ [^a-zA-Z0-9._-] ]]; then
    echo "error: invalid characters: $UNIT_BASENAME" >&2
    exit 2
fi

# Must match mythos-*.service or mythos-*.timer
if [[ ! "$UNIT_BASENAME" =~ ^mythos-[a-zA-Z0-9_-]+\.(service|timer)$ ]]; then
    echo "error: unit must match mythos-*.service or mythos-*.timer: $UNIT_BASENAME" >&2
    exit 2
fi

SOURCE="/opt/mythos/systemd/$UNIT_BASENAME"
DEST="/etc/systemd/system/$UNIT_BASENAME"

if [[ ! -f "$SOURCE" ]]; then
    echo "error: source does not exist: $SOURCE" >&2
    exit 2
fi

# systemd-analyze verify — warning only, don't block on failure
if ! /bin/systemd-analyze verify "$SOURCE" 2>&1; then
    echo "" >&2
    echo "warning: systemd-analyze verify reported issues with $SOURCE" >&2
    echo "         proceeding with install anyway (verify can be strict)" >&2
    echo "" >&2
fi

/usr/bin/install -m 0644 -o root -g root "$SOURCE" "$DEST"
/bin/systemctl daemon-reload

echo "installed: $DEST"
