#!/bin/bash
# /usr/local/libexec/mythos/mythos-servicectl
# Root-owned wrapper for systemctl operations on approved Mythos services.
# Installed by SYS-0062.

set -euo pipefail

ALLOWLIST_FILE="/etc/mythos/allowed-units.txt"

ACTION="${1:-}"
UNIT="${2:-}"

# Validate action
case "$ACTION" in
    start|stop|restart|reload|is-active|is-enabled|enable|disable|daemon-reload)
        ;;
    *)
        echo "usage: mythos-servicectl <action> [unit]" >&2
        echo "  actions: start stop restart reload is-active is-enabled enable disable daemon-reload" >&2
        exit 2
        ;;
esac

# daemon-reload takes no unit
if [[ "$ACTION" == "daemon-reload" ]]; then
    if [[ $# -ne 1 ]]; then
        echo "error: daemon-reload takes no unit argument" >&2
        exit 2
    fi
    exec /bin/systemctl daemon-reload
fi

# All other actions require exactly 2 arguments
if [[ $# -ne 2 ]]; then
    echo "error: expected 'mythos-servicectl <action> <unit>', got $# args" >&2
    exit 2
fi

if [[ -z "$UNIT" ]]; then
    echo "error: unit name required for '$ACTION'" >&2
    exit 2
fi

# Reject shell metacharacters and path separators
if [[ "$UNIT" =~ [^a-zA-Z0-9._-] ]]; then
    echo "error: invalid characters in unit name: $UNIT" >&2
    exit 2
fi

# Allowlist check
if [[ ! -f "$ALLOWLIST_FILE" ]]; then
    echo "error: allowlist file missing: $ALLOWLIST_FILE" >&2
    exit 2
fi

if ! /bin/grep -qxF "$UNIT" <(/usr/bin/sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$ALLOWLIST_FILE"); then
    echo "error: unit not in allowlist: $UNIT" >&2
    echo "  (to add: sudo /usr/local/libexec/mythos/mythos-allowlist-append <unit>)" >&2
    exit 2
fi

# Guard against enable/start of not-yet-installed units
if [[ "$ACTION" == "enable" || "$ACTION" == "start" ]]; then
    if [[ ! -f "/etc/systemd/system/$UNIT" && ! -f "/lib/systemd/system/$UNIT" && ! -f "/usr/lib/systemd/system/$UNIT" ]]; then
        echo "error: cannot $ACTION unit that is not installed: $UNIT" >&2
        echo "  (install it first with mythos-install-unit)" >&2
        exit 2
    fi
fi

exec /bin/systemctl "$ACTION" "$UNIT"
