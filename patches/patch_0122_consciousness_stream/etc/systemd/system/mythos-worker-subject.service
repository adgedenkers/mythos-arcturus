[Unit]
Description=Mythos Subject Enrichment Worker
After=network.target postgresql.service mythos-redis.service
Wants=postgresql.service

[Service]
Type=simple
User=adge
Group=adge
WorkingDirectory=/opt/mythos
ExecStart=/opt/mythos/.venv/bin/python3 /opt/mythos/workers/worker.py subject
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
