WRAPPER_DIR = "/usr/local/libexec/mythos"

def sudo_wrapper(self, wrapper_name, *args, timeout=120, check=True):
    """
    Invoke a Mythos privileged wrapper via sudo -n.

    Args:
        wrapper_name: bare name (e.g. "mythos-servicectl")
        *args: arguments to pass to the wrapper
        timeout: subprocess timeout in seconds
        check: if True, raise on non-zero exit

    Returns:
        subprocess.CompletedProcess

    Raises:
        RuntimeError if the wrapper is not installed (SYS-0063 missing)
        subprocess.CalledProcessError if check=True and wrapper fails
        subprocess.TimeoutExpired if timeout exceeded
    """
    wrapper_path = os.path.join(self.WRAPPER_DIR, wrapper_name)
    if not os.path.isfile(wrapper_path):
        raise RuntimeError(
            f"Mythos privilege wrapper not found: {wrapper_path}. "
            f"Install SYS-0063 first (privilege foundation)."
        )

    cmd = ["sudo", "-n", wrapper_path] + list(args)
    return subprocess.run(
        cmd,
        check=check,
        capture_output=True,
        text=True,
        timeout=timeout,
    )
