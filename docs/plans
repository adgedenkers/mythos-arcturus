### 6.6 Sudoers content linting

Before atomic install (step 12), lint the tempfile content:

```python
EXPECTED_WRAPPERS = {
    "mythos-servicectl",
    "mythos-install-unit",
    "mythos-install-cloudflared-config",
    "mythos-fix-ownership",
    "mythos-scan-perms",
    "mythos-backup-git",
    "mythos-clean-tmp-pack",
    "mythos-allowlist-append",
}

# Wrappers that take arguments (trailing * allowed)
WRAPPERS_WITH_ARGS = {
    "mythos-servicectl",
    "mythos-install-unit",
    "mythos-allowlist-append",
}

DANGEROUS_TOKENS = [
    "bash", "sh", "perl", "python", "awk", "sed", "vim", "less", "more",
    "cp", "mv", "dd", "nc", "find", "tar", "chmod", "chown", "mount",
]

def lint_sudoers_content(tempfile_path):
    # 1. File must be small
    size = os.path.getsize(tempfile_path)
    if size > 2048:
        raise LintError(f"sudoers file too large: {size} bytes")

    with open(tempfile_path, 'r') as f:
        content = f.read()

    # 2. Must end with newline
    if not content.endswith('\n'):
        raise LintError("sudoers file does not end with newline")

    seen_wrappers = set()

    for lineno, line in enumerate(content.splitlines(), 1):
        stripped = line.strip()

        # Blank lines and comments are fine
        if not stripped or stripped.startswith('#'):
            continue

        # 3. Every rule line must match exact pattern
        # adge ALL=(root) NOPASSWD: /usr/local/libexec/mythos/<wrapper>( *)?
        import re
        pattern = re.compile(
            r'^adge ALL=\(root\) NOPASSWD: /usr/local/libexec/mythos/([a-z-]+)( \*)?$'
        )
        m = pattern.match(stripped)
        if not m:
            raise LintError(f"line {lineno}: does not match expected sudoers rule pattern: {stripped}")

        wrapper_name = m.group(1)
        has_wildcard = m.group(2) is not None

        # 4. Wrapper name must be in expected set
        if wrapper_name not in EXPECTED_WRAPPERS:
            raise LintError(f"line {lineno}: unknown wrapper: {wrapper_name}")

        # 5. Wildcard must match wrapper's expected arg behavior
        if has_wildcard and wrapper_name not in WRAPPERS_WITH_ARGS:
            raise LintError(f"line {lineno}: wrapper {wrapper_name} should not have trailing wildcard")
        if not has_wildcard and wrapper_name in WRAPPERS_WITH_ARGS:
            raise LintError(f"line {lineno}: wrapper {wrapper_name} needs trailing wildcard")

        seen_wrappers.add(wrapper_name)

    # 6. All expected wrappers must be present
    missing = EXPECTED_WRAPPERS - seen_wrappers
    if missing:
        raise LintError(f"missing sudoers rules for: {missing}")

    # 7. Dangerous tokens check (defense in depth)
    for token in DANGEROUS_TOKENS:
        # Check for the token as a standalone word outside /usr/local/libexec/mythos/ path
        # This is conservative — we're looking for any raw dangerous command
        import re
        token_pattern = re.compile(rf'(?<![/a-zA-Z-])\b{re.escape(token)}\b')
        for lineno, line in enumerate(content.splitlines(), 1):
            # Skip comments
            if line.strip().startswith('#'):
                continue
            # Allow the wrapper path itself
            cleaned = line.replace('/usr/local/libexec/mythos/mythos-', '')
            if token_pattern.search(cleaned):
                raise LintError(f"line {lineno}: dangerous token '{token}' found")
