## 5. Wrapper script full source

**Every wrapper starts with:**
```bash
#!/bin/bash
set -euo pipefail
```

### 5.1 `mythos-servicectl`

```bash
#!/bin/bash
# /usr/local/libexec/mythos/mythos-servicectl
# Root-owned wrapper for systemctl operations on approved Mythos services.
# Installed by SYS-0063.

set -euo pipefail

ALLOWLIST_FILE="/etc/mythos/allowed-units.txt"

ACTION="${1:-}"
UNIT="${2:-}"

# Validate action
case "$ACTION" in
    start|stop|restart|reload|is-active|is-enabled|enable|disable|daemon-reload)
        ;;
    *)
        echo "usage: mythos-servicectl <action> [unit]" >&2
        echo "  actions: start stop restart reload is-active is-enabled enable disable daemon-reload" >&2
        exit 2
        ;;
esac

# daemon-reload takes no unit
if [[ "$ACTION" == "daemon-reload" ]]; then
    if [[ $# -ne 1 ]]; then
        echo "error: daemon-reload takes no unit argument" >&2
        exit 2
    fi
    exec /bin/systemctl daemon-reload
fi

# All other actions require exactly 2 arguments
if [[ $# -ne 2 ]]; then
    echo "error: expected 'mythos-servicectl <action> <unit>', got $# args" >&2
    exit 2
fi

if [[ -z "$UNIT" ]]; then
    echo "error: unit name required for '$ACTION'" >&2
    exit 2
fi

# Reject shell metacharacters and path separators
if [[ "$UNIT" =~ [^a-zA-Z0-9._-] ]]; then
    echo "error: invalid characters in unit name: $UNIT" >&2
    exit 2
fi

# Allowlist check
if [[ ! -f "$ALLOWLIST_FILE" ]]; then
    echo "error: allowlist file missing: $ALLOWLIST_FILE" >&2
    exit 2
fi

if ! /bin/grep -qxF "$UNIT" <(/usr/bin/sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$ALLOWLIST_FILE"); then
    echo "error: unit not in allowlist: $UNIT" >&2
    echo "  (to add: mythos-allowlist-append <unit>)" >&2
    exit 2
fi

# Guard against enable/start of not-yet-installed units
if [[ "$ACTION" == "enable" || "$ACTION" == "start" ]]; then
    if [[ ! -f "/etc/systemd/system/$UNIT" && ! -f "/lib/systemd/system/$UNIT" && ! -f "/usr/lib/systemd/system/$UNIT" ]]; then
        echo "error: cannot $ACTION unit that is not installed: $UNIT" >&2
        echo "  (install it first with mythos-install-unit)" >&2
        exit 2
    fi
fi

exec /bin/systemctl "$ACTION" "$UNIT"
```

### 5.2 `mythos-install-unit`

```bash
#!/bin/bash
# /usr/local/libexec/mythos/mythos-install-unit
# Deploy a systemd unit file from /opt/mythos/systemd/ to /etc/systemd/system/.

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: mythos-install-unit <basename.service|basename.timer>" >&2
    exit 2
fi

UNIT_BASENAME="$1"

# Basename only — reject any path component
if [[ "$UNIT_BASENAME" == */* ]]; then
    echo "error: basename only, no paths: $UNIT_BASENAME" >&2
    exit 2
fi

# Reject shell metacharacters
if [[ "$UNIT_BASENAME" =~ [^a-zA-Z0-9._-] ]]; then
    echo "error: invalid characters: $UNIT_BASENAME" >&2
    exit 2
fi

# Must match mythos-*.service or mythos-*.timer
if [[ ! "$UNIT_BASENAME" =~ ^mythos-[a-zA-Z0-9_-]+\.(service|timer)$ ]]; then
    echo "error: unit must match mythos-*.service or mythos-*.timer: $UNIT_BASENAME" >&2
    exit 2
fi

SOURCE="/opt/mythos/systemd/$UNIT_BASENAME"
DEST="/etc/systemd/system/$UNIT_BASENAME"

if [[ ! -f "$SOURCE" ]]; then
    echo "error: source does not exist: $SOURCE" >&2
    exit 2
fi

# systemd-analyze verify — warning only, don't block on failure
if ! /bin/systemd-analyze verify "$SOURCE" 2>&1; then
    echo "" >&2
    echo "warning: systemd-analyze verify reported issues with $SOURCE" >&2
    echo "         proceeding with install anyway (verify can be strict)" >&2
    echo "" >&2
fi

/usr/bin/install -m 0644 -o root -g root "$SOURCE" "$DEST"
/bin/systemctl daemon-reload

echo "installed: $DEST"
```

### 5.3 `mythos-install-cloudflared-config`

```bash
#!/bin/bash
# /usr/local/libexec/mythos/mythos-install-cloudflared-config
# Deploy /opt/mythos/cloudflared/config.yml to /etc/cloudflared/config.yml

set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "usage: mythos-install-cloudflared-config (no arguments)" >&2
    exit 2
fi

SOURCE="/opt/mythos/cloudflared/config.yml"
DEST="/etc/cloudflared/config.yml"

if [[ ! -f "$SOURCE" ]]; then
    echo "error: source does not exist: $SOURCE" >&2
    exit 2
fi

# Basic YAML sanity: first non-empty line should look YAML-ish
if ! /usr/bin/head -20 "$SOURCE" | /bin/grep -qE '^[a-zA-Z#]'; then
    echo "error: source does not look like valid YAML" >&2
    exit 2
fi

/usr/bin/install -m 0644 -o root -g root "$SOURCE" "$DEST"

echo "installed: $DEST"
```

### 5.4 `mythos-fix-ownership`

```bash
#!/bin/bash
# /usr/local/libexec/mythos/mythos-fix-ownership
# Recursive chown /opt/mythos to adge:adge. Recovery operation for
# cases where legacy patch framework bugs left root-owned files.

set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "usage: mythos-fix-ownership (no arguments)" >&2
    exit 2
fi

TARGET="/opt/mythos"

if [[ ! -d "$TARGET" ]]; then
    echo "error: $TARGET does not exist" >&2
    exit 2
fi

# Signature file check — don't chown something that isn't Mythos
for sig in "$TARGET/patches/scripts/patch_base.py" "$TARGET/docs/STREAMS.json" "$TARGET/.env"; do
    if [[ ! -f "$sig" ]]; then
        echo "error: signature file missing: $sig — not a Mythos tree" >&2
        exit 2
    fi
done

/bin/chown -R adge:adge "$TARGET/"

echo "chowned: $TARGET/ to adge:adge"
```

### 5.5 `mythos-scan-perms`

```bash
#!/bin/bash
# /usr/local/libexec/mythos/mythos-scan-perms
# Count files under /opt/mythos NOT owned by adge:adge.
# Default behavior is quiet (count to stdout only).
# Pass --verbose as an argument to dump up to 20 sample paths to stderr.

set -euo pipefail

VERBOSE=0
if [[ $# -eq 1 && "$1" == "--verbose" ]]; then
    VERBOSE=1
elif [[ $# -ne 0 ]]; then
    echo "usage: mythos-scan-perms [--verbose]" >&2
    exit 2
fi

TARGET="/opt/mythos"

if [[ ! -d "$TARGET" ]]; then
    echo "error: $TARGET does not exist" >&2
    exit 2
fi

COUNT=$(/usr/bin/find "$TARGET" \( -not -user adge -o -not -group adge \) -print 2>/dev/null | /usr/bin/wc -l)
echo "$COUNT"

if [[ "$VERBOSE" -eq 1 && "$COUNT" -gt 0 ]]; then
    echo "---sample (first 20)---" >&2
    /usr/bin/find "$TARGET" \( -not -user adge -o -not -group adge \) -print 2>/dev/null | /usr/bin/head -20 >&2
fi

exit 0
```

### 5.6 `mythos-backup-git`

```bash
#!/bin/bash
# /usr/local/libexec/mythos/mythos-backup-git
# Create a timestamped tar.gz of /opt/mythos/.git in /tmp/.
# Outputs the resulting path to stdout.

set -euo pipefail

# Tight default permissions on created files
umask 077

if [[ $# -ne 0 ]]; then
    echo "usage: mythos-backup-git (no arguments)" >&2
    exit 2
fi

if [[ ! -d "/opt/mythos/.git" ]]; then
    echo "error: /opt/mythos/.git does not exist" >&2
    exit 2
fi

TIMESTAMP=$(/bin/date +%Y%m%d_%H%M%S)
BACKUP_PATH="/tmp/mythos_git_backup_${TIMESTAMP}.tar.gz"

/bin/tar czf "$BACKUP_PATH" -C /opt/mythos .git

echo "$BACKUP_PATH"
```

### 5.7 `mythos-clean-tmp-pack`

```bash
#!/bin/bash
# /usr/local/libexec/mythos/mythos-clean-tmp-pack
# Remove stale tmp_pack_* files from /opt/mythos/.git/objects/pack/.
# Safe no-op if there are none.

set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "usage: mythos-clean-tmp-pack (no arguments)" >&2
    exit 2
fi

PACK_DIR="/opt/mythos/.git/objects/pack"

if [[ ! -d "$PACK_DIR" ]]; then
    echo "error: $PACK_DIR does not exist" >&2
    exit 2
fi

REMOVED=0
while IFS= read -r -d '' f; do
    /bin/rm -f "$f"
    REMOVED=$((REMOVED + 1))
done < <(/usr/bin/find "$PACK_DIR" -maxdepth 1 -type f -name "tmp_pack_*" -print0 2>/dev/null)

echo "removed: $REMOVED file(s)"
```

### 5.8 `mythos-allowlist-append`

```bash
#!/bin/bash
# /usr/local/libexec/mythos/mythos-allowlist-append
# Append a unit name to /etc/mythos/allowed-units.txt.
# Idempotent: if the unit is already present, exits cleanly with a message.

set -euo pipefail

ALLOWLIST_FILE="/etc/mythos/allowed-units.txt"

if [[ $# -ne 1 ]]; then
    echo "usage: mythos-allowlist-append <unit>" >&2
    exit 2
fi

UNIT="$1"

# Reject shell metacharacters and path separators
if [[ "$UNIT" =~ [^a-zA-Z0-9._-] ]]; then
    echo "error: invalid characters in unit: $UNIT" >&2
    exit 2
fi

# Must end with .service or .timer
if [[ ! "$UNIT" =~ ^[a-zA-Z0-9_-]+\.(service|timer)$ ]]; then
    echo "error: unit must match <name>.service or <name>.timer: $UNIT" >&2
    exit 2
fi

if [[ ! -f "$ALLOWLIST_FILE" ]]; then
    echo "error: allowlist file missing: $ALLOWLIST_FILE" >&2
    exit 2
fi

# Check for duplicate (exact match, ignoring comments and blanks)
if /bin/grep -qxF "$UNIT" <(/usr/bin/sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$ALLOWLIST_FILE"); then
    echo "already in allowlist: $UNIT"
    exit 0
fi

# Atomic append via flock
(
    /usr/bin/flock -x 200
    echo "$UNIT" >> "$ALLOWLIST_FILE"
) 200<"$ALLOWLIST_FILE"

echo "appended: $UNIT"
```

