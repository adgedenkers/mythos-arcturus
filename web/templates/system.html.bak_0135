<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mythos — System Status</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=JetBrains+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root { --bg:#050810;--bg-card:rgba(12,17,30,0.85);--border:rgba(30,42,65,0.6);--text:#e2e8f0;--dim:#64748b;--muted:#334155;--cyan:#06b6d4;--gold:#d4a574;--green:#22c55e;--red:#ef4444;--amber:#f59e0b; }
* { margin:0;padding:0;box-sizing:border-box; }
body { background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif; }
.topbar { position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:14px 28px;background:rgba(5,8,16,0.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--border); }
.topbar-logo { font-family:'Cinzel',serif;font-size:16px;font-weight:600;letter-spacing:4px;color:var(--gold); }
.topbar-nav { display:flex;gap:2px; }
.topbar-nav a { padding:7px 16px;border-radius:6px;color:var(--dim);text-decoration:none;font-size:13px;font-weight:500;transition:all 0.2s; }
.topbar-nav a:hover { color:var(--text);background:rgba(255,255,255,0.04); }
.topbar-nav a.active { color:var(--cyan);background:rgba(6,182,212,0.08); }
.topbar-right { display:flex;align-items:center;gap:14px; }
.topbar-user { font-size:12px;color:var(--dim);font-family:'JetBrains Mono',monospace; }
.topbar-logout { padding:5px 12px;border:1px solid var(--border);border-radius:5px;background:transparent;color:var(--muted);font-size:11px;text-decoration:none; }
.main { padding:80px 28px 40px;max-width:1200px;margin:0 auto; }
.page-header { padding:30px 0 20px; }
.page-header h1 { font-family:'Cinzel',serif;font-size:24px;font-weight:600;letter-spacing:2px;color:var(--green); }
.page-header .sub { font-size:13px;color:var(--dim);margin-top:4px; }

.services-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-bottom:30px; }
.service-card { background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:18px;display:flex;align-items:center;gap:14px; }
.svc-dot { width:10px;height:10px;border-radius:50%;flex-shrink:0; }
.svc-dot.up { background:var(--green);box-shadow:0 0 8px rgba(34,197,94,0.4); }
.svc-dot.down { background:var(--red);box-shadow:0 0 8px rgba(239,68,68,0.4); }
.svc-dot.unknown { background:var(--muted); }
.svc-info { flex:1; }
.svc-name { font-weight:600;font-size:14px; }
.svc-detail { font-size:11px;color:var(--dim);font-family:'JetBrains Mono',monospace;margin-top:2px; }
.svc-status { font-size:11px;font-family:'JetBrains Mono',monospace; }
.svc-status.up { color:var(--green); }
.svc-status.down { color:var(--red); }

.section-title { font-family:'Cinzel',serif;font-size:16px;font-weight:600;letter-spacing:1px;color:var(--dim);margin:30px 0 12px;padding-bottom:8px;border-bottom:1px solid var(--border); }

.resource-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px; }
.resource-card { background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:18px; }
.res-label { font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--muted);margin-bottom:6px; }
.res-value { font-family:'JetBrains Mono',monospace;font-size:20px;font-weight:500; }
.res-bar { margin-top:8px;height:4px;background:rgba(30,42,65,0.5);border-radius:2px;overflow:hidden; }
.res-bar-fill { height:100%;border-radius:2px;transition:width 0.5s; }
.res-sub { font-size:11px;color:var(--dim);margin-top:4px;font-family:'JetBrains Mono',monospace; }

.patch-list { margin-top:12px; }
.patch-row { display:flex;justify-content:space-between;align-items:center;padding:8px 14px;border-bottom:1px solid rgba(30,42,65,0.3);font-size:13px; }
.patch-row:last-child { border-bottom:none; }
.patch-name { font-family:'JetBrains Mono',monospace;font-size:12px; }
.patch-date { font-size:11px;color:var(--dim);font-family:'JetBrains Mono',monospace; }
.patch-tag { font-size:10px;padding:2px 6px;border-radius:3px;background:rgba(34,197,94,0.1);color:var(--green); }

.loading { text-align:center;padding:40px;color:var(--muted); }
.mono { font-family:'JetBrains Mono',monospace; }
</style>
</head>
<body>
<div class="topbar">
  <div class="topbar-logo">MYTHOS</div>
  <nav class="topbar-nav">
    <a href="/app/">Home</a>
    <a href="/app/finance/">Finance</a>
    <a href="/app/people/">People</a>
    <a href="/app/ontology/">Ontology</a>
    <a href="/app/system/" class="active">System</a>
    <a href="/app/sessions/">Sessions</a>
    <a href="/app/registry/">Registry</a>
  </nav>
  <div class="topbar-right">
    <span class="topbar-user" id="user-name"></span>
    <a href="/auth/logout" class="topbar-logout">logout</a>
  </div>
</div>

<div class="main">
  <div class="page-header">
    <h1>⬡ System Status</h1>
    <div class="sub">Arcturus · <span id="hostname" class="mono"></span> · Last checked: <span id="check-time" class="mono"></span></div>
  </div>

  <div class="services-grid" id="services"><div class="loading">Loading services...</div></div>

  <div class="section-title">Resources</div>
  <div class="resource-grid" id="resources"><div class="loading">Loading...</div></div>

  <div class="section-title">Databases</div>
  <div class="resource-grid" id="databases"><div class="loading">Loading...</div></div>

  <div class="section-title">Recent Patches</div>
  <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow:hidden;">
    <div class="patch-list" id="patches"><div class="loading">Loading...</div></div>
  </div>
</div>

<script>
fetch('/auth/me').then(r=>{if(!r.ok)throw 'a';return r.json()}).then(d=>{document.getElementById('user-name').textContent=d.name||d.email}).catch(()=>{window.location.href='/app/login'});

fetch('/api/system/status')
  .then(r=>r.json())
  .then(d=>{
    document.getElementById('check-time').textContent = new Date().toLocaleTimeString();
    document.getElementById('hostname').textContent = d.hostname || 'arcturus';

    // Services
    const sg = document.getElementById('services');
    sg.innerHTML = (d.services||[]).map(s=>`
      <div class="service-card">
        <div class="svc-dot ${s.active?'up':'down'}"></div>
        <div class="svc-info">
          <div class="svc-name">${s.name}</div>
          <div class="svc-detail">${s.description||s.unit||''}</div>
        </div>
        <div class="svc-status ${s.active?'up':'down'}">${s.active?'running':'stopped'}</div>
      </div>
    `).join('');

    // Resources
    const rg = document.getElementById('resources');
    const cpu = d.cpu||{};
    const mem = d.memory||{};
    const disk = d.disk||{};
    const barColor = pct => pct>90?'var(--red)':pct>70?'var(--amber)':'var(--green)';
    rg.innerHTML = `
      <div class="resource-card">
        <div class="res-label">CPU</div>
        <div class="res-value">${cpu.percent||0}%</div>
        <div class="res-bar"><div class="res-bar-fill" style="width:${cpu.percent||0}%;background:${barColor(cpu.percent||0)}"></div></div>
        <div class="res-sub">${cpu.cores||'?'} cores · ${cpu.load_1m||'?'} load</div>
      </div>
      <div class="resource-card">
        <div class="res-label">Memory</div>
        <div class="res-value">${mem.percent||0}%</div>
        <div class="res-bar"><div class="res-bar-fill" style="width:${mem.percent||0}%;background:${barColor(mem.percent||0)}"></div></div>
        <div class="res-sub">${mem.used_gb||'?'}GB / ${mem.total_gb||'?'}GB</div>
      </div>
      <div class="resource-card">
        <div class="res-label">Disk</div>
        <div class="res-value">${disk.percent||0}%</div>
        <div class="res-bar"><div class="res-bar-fill" style="width:${disk.percent||0}%;background:${barColor(disk.percent||0)}"></div></div>
        <div class="res-sub">${disk.used_gb||'?'}GB / ${disk.total_gb||'?'}GB</div>
      </div>
      <div class="resource-card">
        <div class="res-label">GPU</div>
        <div class="res-value">${d.gpu?d.gpu.name||'—':'—'}</div>
        <div class="res-sub">${d.gpu?d.gpu.memory||'':'not detected'}</div>
      </div>
    `;

    // Databases
    const dg = document.getElementById('databases');
    dg.innerHTML = (d.databases||[]).map(db=>`
      <div class="resource-card">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div class="res-label">${db.name}</div>
          <div class="svc-dot ${db.connected?'up':'down'}" style="width:6px;height:6px"></div>
        </div>
        <div class="res-value" style="font-size:14px">${db.connected?'Connected':'Offline'}</div>
        <div class="res-sub">${db.details||''}</div>
      </div>
    `).join('');

    // Patches
    const pg = document.getElementById('patches');
    pg.innerHTML = (d.patches||[]).slice(0,10).map(p=>`
      <div class="patch-row">
        <span class="patch-name">${p.name}</span>
        <span class="patch-date">${p.date||''}</span>
        <span class="patch-tag">${p.status||'applied'}</span>
      </div>
    `).join('') || '<div class="loading">No patches found</div>';
  })
  .catch(err=>{
    document.getElementById('services').innerHTML='<div class="loading" style="color:var(--red)">Failed to load: '+err+'</div>';
  });
</script>
</body>
</html>
