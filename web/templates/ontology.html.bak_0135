<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mythos — Ontology</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=JetBrains+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<style>
:root {
  --bg:#050810; --bg-card:rgba(12,17,30,0.85); --bg-hover:rgba(26,35,50,0.9);
  --border:rgba(30,42,65,0.6); --border-glow:rgba(6,182,212,0.15);
  --text:#e2e8f0; --dim:#64748b; --muted:#334155;
  --cyan:#06b6d4; --gold:#d4a574; --purple:#8b5cf6; --green:#22c55e;
  --red:#ef4444; --amber:#f59e0b; --rose:#f472b6;
  --cyan-bg:rgba(6,182,212,0.08); --gold-bg:rgba(212,165,116,0.08);
  --purple-bg:rgba(139,92,246,0.08); --green-bg:rgba(34,197,94,0.08);
  --amber-bg:rgba(245,158,11,0.08); --rose-bg:rgba(244,114,182,0.08);
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;overflow:hidden;height:100vh;display:flex;flex-direction:column;}

/* ── Background ── */
.bg-layer{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;}
.bg-radial{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 30%,rgba(6,182,212,0.05) 0%,transparent 60%),radial-gradient(ellipse at 80% 70%,rgba(139,92,246,0.03) 0%,transparent 50%);}
.bg-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(6,182,212,0.015) 1px,transparent 1px),linear-gradient(90deg,rgba(6,182,212,0.015) 1px,transparent 1px);background-size:80px 80px;}

/* ── Topbar ── */
.topbar{position:relative;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:14px 28px;background:rgba(5,8,16,0.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);flex-shrink:0;}
.topbar-logo{font-family:'Cinzel',serif;font-size:16px;font-weight:600;letter-spacing:4px;color:var(--gold);}
.topbar-nav{display:flex;gap:2px;}
.topbar-nav a{padding:7px 16px;border-radius:6px;color:var(--dim);text-decoration:none;font-size:13px;font-weight:500;transition:all .2s;}
.topbar-nav a:hover{color:var(--text);background:rgba(255,255,255,0.04);}
.topbar-nav a.active{color:var(--cyan);background:var(--cyan-bg);}
.topbar-right{display:flex;align-items:center;gap:14px;}
.topbar-user{font-size:12px;color:var(--dim);font-family:'JetBrains Mono',monospace;}
.topbar-logout{padding:5px 12px;border:1px solid var(--border);border-radius:5px;background:transparent;color:var(--muted);font-size:11px;text-decoration:none;transition:all .2s;}
.topbar-logout:hover{border-color:var(--red);color:var(--red);}

/* ── Layout ── */
.app-body{display:flex;flex:1;overflow:hidden;position:relative;z-index:1;}

/* ── Left Panel: Term List ── */
.term-list-panel{width:380px;background:var(--bg-card);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;}
.search-bar{padding:16px;border-bottom:1px solid var(--border);}
.search-input{width:100%;padding:10px 14px 10px 36px;background:rgba(5,8,16,0.6);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;outline:none;transition:border-color .2s;}
.search-input:focus{border-color:var(--cyan);}
.search-wrap{position:relative;}
.search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:14px;pointer-events:none;}
.category-tabs{display:flex;gap:4px;padding:10px 16px;border-bottom:1px solid var(--border);flex-wrap:wrap;}
.cat-tab{padding:4px 10px;border-radius:5px;font-size:11px;font-weight:500;cursor:pointer;transition:all .15s;border:1px solid transparent;color:var(--dim);background:transparent;}
.cat-tab:hover{color:var(--text);background:rgba(255,255,255,0.04);}
.cat-tab.active{border-color:var(--cyan);color:var(--cyan);background:var(--cyan-bg);}
.cat-tab .count{font-family:'JetBrains Mono',monospace;font-size:10px;opacity:0.6;margin-left:3px;}
.term-scroll{flex:1;overflow-y:auto;padding:8px;}
.term-item{padding:12px 14px;border-radius:8px;cursor:pointer;transition:all .15s;border:1px solid transparent;margin-bottom:2px;}
.term-item:hover{background:var(--bg-hover);border-color:var(--border);}
.term-item.active{background:var(--cyan-bg);border-color:rgba(6,182,212,0.3);}
.term-name{font-size:14px;font-weight:500;margin-bottom:3px;}
.term-item.active .term-name{color:var(--cyan);}
.term-meta{display:flex;align-items:center;gap:8px;}
.term-cat{font-size:10px;font-family:'JetBrains Mono',monospace;letter-spacing:0.5px;text-transform:uppercase;padding:2px 6px;border-radius:3px;}
.cat-Astrology{color:var(--cyan);background:var(--cyan-bg);}
.cat-Numerology{color:var(--purple);background:var(--purple-bg);}
.cat-Tarot{color:var(--gold);background:var(--gold-bg);}
.cat-Mythos-Core,.cat-Mythos{color:var(--green);background:var(--green-bg);}
.term-rels{font-size:10px;color:var(--muted);font-family:'JetBrains Mono',monospace;}
.term-count{font-size:11px;color:var(--muted);padding:8px 16px;border-top:1px solid var(--border);font-family:'JetBrains Mono',monospace;text-align:center;}

/* ── Right Panel: Detail + Graph ── */
.detail-panel{flex:1;display:flex;flex-direction:column;overflow:hidden;}
.detail-empty{flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;}
.detail-empty .icon{font-size:48px;opacity:0.15;}
.detail-empty .msg{font-size:14px;color:var(--muted);font-family:'JetBrains Mono',monospace;letter-spacing:1px;}

/* Detail content */
.detail-content{flex:1;overflow-y:auto;padding:0;}
.detail-header{padding:32px 32px 0;border-bottom:1px solid var(--border);padding-bottom:24px;}
.detail-title{font-family:'Cinzel',serif;font-size:28px;font-weight:600;letter-spacing:1px;margin-bottom:8px;}
.detail-badges{display:flex;gap:8px;align-items:center;margin-bottom:16px;flex-wrap:wrap;}
.detail-cat{font-size:11px;font-family:'JetBrains Mono',monospace;letter-spacing:0.5px;text-transform:uppercase;padding:3px 10px;border-radius:4px;}
.detail-alias{font-size:11px;color:var(--dim);padding:3px 8px;border:1px solid var(--border);border-radius:4px;}
.detail-def{font-size:15px;line-height:1.7;color:var(--text);max-width:700px;}

/* Relationships section */
.detail-rels{padding:24px 32px;}
.rels-heading{font-family:'Cinzel',serif;font-size:14px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-bottom:14px;}
.rel-group{margin-bottom:16px;}
.rel-type-label{font-size:10px;font-family:'JetBrains Mono',monospace;letter-spacing:1px;color:var(--muted);text-transform:uppercase;margin-bottom:6px;}
.rel-chips{display:flex;flex-wrap:wrap;gap:6px;}
.rel-chip{padding:5px 12px;border-radius:6px;font-size:12px;font-weight:500;cursor:pointer;transition:all .15s;border:1px solid var(--border);background:var(--bg-card);}
.rel-chip:hover{border-color:var(--cyan);color:var(--cyan);background:var(--cyan-bg);}
.rel-chip .chip-cat{font-size:9px;margin-left:5px;opacity:0.5;}

/* Graph section */
.graph-section{border-top:1px solid var(--border);padding:24px 32px 0;}
.graph-heading{font-family:'Cinzel',serif;font-size:14px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-bottom:14px;}
.graph-container{width:100%;height:350px;background:rgba(5,8,16,0.4);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:24px;}
.graph-container svg{width:100%;height:100%;}
.graph-container .node circle{cursor:pointer;transition:r .15s;}
.graph-container .node text{font-family:'DM Sans',sans-serif;font-size:11px;fill:var(--text);pointer-events:none;}
.graph-container .link{stroke:var(--border);stroke-opacity:0.5;}
.graph-container .link-label{font-family:'JetBrains Mono',monospace;font-size:8px;fill:var(--muted);}

/* ── Scrollbar ── */
::-webkit-scrollbar{width:6px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px;}
::-webkit-scrollbar-thumb:hover{background:var(--dim);}

/* ── Responsive ── */
@media(max-width:900px){
  .term-list-panel{width:280px;}
  .detail-header{padding:20px 20px 16px;}
  .detail-rels,.graph-section{padding:16px 20px;}
}
@media(max-width:600px){
  .app-body{flex-direction:column;}
  .term-list-panel{width:100%;max-height:40vh;}
  .graph-container{height:250px;}
}

/* ── Animations ── */
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.detail-content{animation:fadeIn .25s ease-out;}
</style>
</head>
<body>

<div class="bg-layer"><div class="bg-radial"></div><div class="bg-grid"></div></div>

<div class="topbar">
  <div class="topbar-logo">MYTHOS</div>
  <nav class="topbar-nav">
    <a href="/app/">Home</a>
    <a href="/app/finance/">Finance</a>
    <a href="/app/people/">People</a>
    <a href="/app/ontology/" class="active">Ontology</a>
    <a href="/app/system/">System</a>
    <a href="/app/sessions/">Sessions</a>
    <a href="/app/registry/">Registry</a>
  </nav>
  <div class="topbar-right">
    <span class="topbar-user" id="user-name"></span>
    <a href="/auth/logout" class="topbar-logout">logout</a>
  </div>
</div>

<div class="app-body">
  <!-- Left: Term List -->
  <div class="term-list-panel">
    <div class="search-bar">
      <div class="search-wrap">
        <span class="search-icon">⌕</span>
        <input type="text" class="search-input" id="search" placeholder="Search terms, definitions, aliases…" autocomplete="off">
      </div>
    </div>
    <div class="category-tabs" id="category-tabs"></div>
    <div class="term-scroll" id="term-list"></div>
    <div class="term-count" id="term-count"></div>
  </div>

  <!-- Right: Detail -->
  <div class="detail-panel" id="detail-panel">
    <div class="detail-empty">
      <div class="icon">✦</div>
      <div class="msg">Select a term to explore</div>
    </div>
  </div>
</div>

<script>
// ── State ──
let allTerms = [];
let categories = [];
let activeCategory = null;
let activeTerm = null;

// ── Auth ──
fetch('/auth/me').then(r=>{if(!r.ok)throw 'a';return r.json()}).then(d=>{
  document.getElementById('user-name').textContent=d.name||d.email;
}).catch(()=>{window.location.href='/app/login'});

// ── Category Colors ──
const catColors = {
  'Astrology': {color:'#06b6d4', bg:'rgba(6,182,212,0.15)'},
  'Numerology': {color:'#8b5cf6', bg:'rgba(139,92,246,0.15)'},
  'Tarot': {color:'#d4a574', bg:'rgba(212,165,116,0.15)'},
  'Mythos Core': {color:'#22c55e', bg:'rgba(34,197,94,0.15)'},
};
function getCatColor(cat) { return catColors[cat] || {color:'#64748b', bg:'rgba(100,116,139,0.1)'}; }
function catClass(cat) { return 'cat-' + (cat||'').replace(/\s+/g, '-'); }

// ── Load Data ──
async function loadTerms() {
  const res = await fetch('/api/ontology/terms');
  const data = await res.json();
  allTerms = data.terms;
  buildCategories();
  renderTermList();
}

function buildCategories() {
  const counts = {};
  allTerms.forEach(t => { counts[t.category] = (counts[t.category]||0)+1; });
  categories = Object.entries(counts).sort((a,b) => b[1]-a[1]);
  renderCategoryTabs();
}

function renderCategoryTabs() {
  const el = document.getElementById('category-tabs');
  let html = `<div class="cat-tab ${!activeCategory?'active':''}" onclick="filterCategory(null)">All<span class="count">${allTerms.length}</span></div>`;
  categories.forEach(([cat, count]) => {
    html += `<div class="cat-tab ${activeCategory===cat?'active':''}" onclick="filterCategory('${cat}')">${cat}<span class="count">${count}</span></div>`;
  });
  el.innerHTML = html;
}

function filterCategory(cat) {
  activeCategory = cat;
  renderCategoryTabs();
  renderTermList();
}

function getFilteredTerms() {
  const search = document.getElementById('search').value.toLowerCase().trim();
  return allTerms.filter(t => {
    if (activeCategory && t.category !== activeCategory) return false;
    if (search) {
      const haystack = [t.name, t.definition, ...(t.aliases||[])].join(' ').toLowerCase();
      return haystack.includes(search);
    }
    return true;
  });
}

function renderTermList() {
  const terms = getFilteredTerms();
  const el = document.getElementById('term-list');
  el.innerHTML = terms.map(t => `
    <div class="term-item ${activeTerm===t.name?'active':''}" onclick="selectTerm('${t.name.replace(/'/g,"\\'")}')">
      <div class="term-name">${t.name}</div>
      <div class="term-meta">
        <span class="term-cat ${catClass(t.category)}">${t.category}</span>
        ${t.relationship_count ? `<span class="term-rels">${t.relationship_count} links</span>` : ''}
      </div>
    </div>
  `).join('');
  document.getElementById('term-count').textContent = `${terms.length} term${terms.length!==1?'s':''}`;
}

// ── Term Detail ──
async function selectTerm(name) {
  activeTerm = name;
  renderTermList();
  const res = await fetch(`/api/ontology/terms/${encodeURIComponent(name)}`);
  const term = await res.json();
  renderDetail(term);
}

function renderDetail(term) {
  const panel = document.getElementById('detail-panel');
  const cc = getCatColor(term.category);

  const aliasHtml = (term.aliases||[]).map(a => `<span class="detail-alias">${a}</span>`).join('');

  // Group relationships by type
  const outGroups = {};
  (term.related_to||[]).forEach(r => {
    if (!outGroups[r.type]) outGroups[r.type] = [];
    outGroups[r.type].push(r);
  });
  const inGroups = {};
  (term.related_from||[]).forEach(r => {
    if (!inGroups[r.type]) inGroups[r.type] = [];
    inGroups[r.type].push(r);
  });

  const hasRels = (term.related_to||[]).length + (term.related_from||[]).length > 0;

  let relsHtml = '';
  if (hasRels) {
    relsHtml = `<div class="detail-rels">
      <div class="rels-heading">Connections</div>`;

    // Outgoing
    for (const [type, rels] of Object.entries(outGroups)) {
      relsHtml += `<div class="rel-group">
        <div class="rel-type-label">→ ${type.replace(/_/g,' ')}</div>
        <div class="rel-chips">${rels.map(r =>
          `<div class="rel-chip" onclick="selectTerm('${r.name.replace(/'/g,"\\'")}')">${r.name}<span class="chip-cat">${r.category}</span></div>`
        ).join('')}</div>
      </div>`;
    }

    // Incoming
    for (const [type, rels] of Object.entries(inGroups)) {
      relsHtml += `<div class="rel-group">
        <div class="rel-type-label">← ${type.replace(/_/g,' ')} (from)</div>
        <div class="rel-chips">${rels.map(r =>
          `<div class="rel-chip" onclick="selectTerm('${r.name.replace(/'/g,"\\'")}')">${r.name}<span class="chip-cat">${r.category}</span></div>`
        ).join('')}</div>
      </div>`;
    }
    relsHtml += '</div>';
  }

  panel.innerHTML = `
    <div class="detail-content">
      <div class="detail-header">
        <div class="detail-title" style="color:${cc.color}">${term.name}</div>
        <div class="detail-badges">
          <span class="detail-cat" style="color:${cc.color};background:${cc.bg}">${term.category}</span>
          ${aliasHtml}
        </div>
        <div class="detail-def">${term.definition}</div>
      </div>
      ${relsHtml}
      ${hasRels ? `<div class="graph-section">
        <div class="graph-heading">Relationship Graph</div>
        <div class="graph-container" id="graph-container"></div>
      </div>` : ''}
    </div>
  `;

  if (hasRels) {
    renderLocalGraph(term);
  }
}

// ── Local D3 Graph ──
function renderLocalGraph(term) {
  const container = document.getElementById('graph-container');
  if (!container) return;

  const width = container.clientWidth;
  const height = container.clientHeight;

  // Build local nodes and edges
  const nodeSet = new Set([term.name]);
  const edges = [];

  (term.related_to||[]).forEach(r => {
    nodeSet.add(r.name);
    edges.push({source: term.name, target: r.name, type: r.type});
  });
  (term.related_from||[]).forEach(r => {
    nodeSet.add(r.name);
    edges.push({source: r.name, target: term.name, type: r.type});
  });

  // Build node data with categories
  const nodeMap = {};
  nodeMap[term.name] = {id: term.name, category: term.category, isCenter: true};
  (term.related_to||[]).forEach(r => { nodeMap[r.name] = {id: r.name, category: r.category, isCenter: false}; });
  (term.related_from||[]).forEach(r => { nodeMap[r.name] = {id: r.name, category: r.category, isCenter: false}; });
  const nodes = Object.values(nodeMap);

  // D3 force simulation
  const svg = d3.select(container).html('').append('svg').attr('width', width).attr('height', height);

  // Arrow marker
  svg.append('defs').append('marker')
    .attr('id','arrow').attr('viewBox','0 -3 6 6').attr('refX',18).attr('refY',0)
    .attr('markerWidth',5).attr('markerHeight',5).attr('orient','auto')
    .append('path').attr('d','M0,-3L6,0L0,3').attr('fill','rgba(100,116,139,0.4)');

  const simulation = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(edges).id(d=>d.id).distance(100))
    .force('charge', d3.forceManyBody().strength(-250))
    .force('center', d3.forceCenter(width/2, height/2))
    .force('collision', d3.forceCollide().radius(35));

  const link = svg.append('g').selectAll('line')
    .data(edges).enter().append('line')
    .attr('class','link').attr('stroke-width',1).attr('marker-end','url(#arrow)');

  const linkLabel = svg.append('g').selectAll('text')
    .data(edges).enter().append('text')
    .attr('class','link-label')
    .text(d => d.type.replace(/_/g,' '));

  const node = svg.append('g').selectAll('g')
    .data(nodes).enter().append('g').attr('class','node');

  node.append('circle')
    .attr('r', d => d.isCenter ? 10 : 7)
    .attr('fill', d => getCatColor(d.category).color)
    .attr('fill-opacity', d => d.isCenter ? 0.9 : 0.6)
    .attr('stroke', d => d.isCenter ? getCatColor(d.category).color : 'none')
    .attr('stroke-width', d => d.isCenter ? 2 : 0)
    .attr('stroke-opacity', 0.3)
    .on('click', (e, d) => { if (!d.isCenter) selectTerm(d.id); });

  node.append('text')
    .text(d => d.id.length > 22 ? d.id.slice(0,20)+'…' : d.id)
    .attr('x', 14).attr('y', 4)
    .style('font-size', d => d.isCenter ? '12px' : '10px')
    .style('font-weight', d => d.isCenter ? '600' : '400')
    .style('fill', d => d.isCenter ? getCatColor(d.category).color : 'var(--dim)');

  // Drag behavior
  node.call(d3.drag()
    .on('start', (e,d) => { if(!e.active) simulation.alphaTarget(0.3).restart(); d.fx=d.x; d.fy=d.y; })
    .on('drag', (e,d) => { d.fx=e.x; d.fy=e.y; })
    .on('end', (e,d) => { if(!e.active) simulation.alphaTarget(0); d.fx=null; d.fy=null; })
  );

  simulation.on('tick', () => {
    link.attr('x1',d=>d.source.x).attr('y1',d=>d.source.y).attr('x2',d=>d.target.x).attr('y2',d=>d.target.y);
    linkLabel.attr('x',d=>(d.source.x+d.target.x)/2).attr('y',d=>(d.source.y+d.target.y)/2);
    node.attr('transform',d=>`translate(${d.x},${d.y})`);
  });
}

// ── Search ──
document.getElementById('search').addEventListener('input', () => {
  renderTermList();
});

// ── Init ──
loadTerms();
</script>
</body>
</html>
