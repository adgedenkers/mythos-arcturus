<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mythos — Finance</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=JetBrains+Mono:wght@300;400;500;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#0a0e17; --bg-card:#111827; --bg-hover:#1a2332;
  --border:#1e293b; --border-light:#293548;
  --text:#e2e8f0; --text-dim:#64748b; --text-muted:#475569;
  --green:#22c55e; --green-bg:rgba(34,197,94,0.08);
  --red:#ef4444; --red-bg:rgba(239,68,68,0.08);
  --amber:#f59e0b; --amber-bg:rgba(245,158,11,0.08);
  --blue:#3b82f6; --blue-bg:rgba(59,130,246,0.08);
  --cyan:#06b6d4; --cyan-bg:rgba(6,182,212,0.08);
  --purple:#a855f7; --purple-bg:rgba(168,85,247,0.08);
  --sidebar-w:200px;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;display:flex;flex-direction:column;height:100vh;overflow:hidden;}

.topbar{display:flex;justify-content:space-between;align-items:center;padding:12px 24px;border-bottom:1px solid var(--border);background:var(--bg-card);flex-shrink:0;z-index:10;}
.topbar-left{display:flex;align-items:center;gap:20px;}
.topbar-nav{display:flex;gap:4px;}
.topbar-nav a{padding:6px 14px;border-radius:6px;color:var(--text-dim);text-decoration:none;font-size:13px;font-weight:500;transition:all .15s;}
.topbar-nav a:hover{color:var(--text);background:var(--bg-hover);}
.topbar-nav a.active{color:var(--cyan);background:var(--cyan-bg);}
.topbar-right{display:flex;align-items:center;gap:12px;}
.user-info{font-size:12px;color:var(--text-dim);}
.logout-btn{padding:5px 12px;border:1px solid var(--border);border-radius:5px;background:transparent;color:var(--text-muted);font-size:12px;cursor:pointer;text-decoration:none;}
.logout-btn:hover{border-color:var(--red);color:var(--red);}

.app-body{display:flex;flex:1;overflow:hidden;}

.sidebar{width:var(--sidebar-w);background:var(--bg-card);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;padding:16px 0;}
.sidebar-section{padding:0 12px;margin-bottom:4px;}
.sidebar-label{font-size:10px;text-transform:uppercase;letter-spacing:1.2px;color:var(--text-muted);padding:8px 8px 4px;}
.sidebar-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:7px;cursor:pointer;color:var(--text-dim);font-size:13px;font-weight:500;transition:all .15s;border:none;background:none;width:100%;text-align:left;}
.sidebar-item:hover{color:var(--text);background:var(--bg-hover);}
.sidebar-item.active{color:var(--cyan);background:var(--cyan-bg);}
.sidebar-item .icon{font-size:15px;width:18px;text-align:center;}
.sidebar-divider{border:none;border-top:1px solid var(--border);margin:8px 12px;}

.main{flex:1;overflow-y:auto;padding:24px;}

.summary-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-bottom:24px;}
.summary-card{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:14px 16px;}
.summary-card .label{font-size:10px;text-transform:uppercase;letter-spacing:1.2px;color:var(--text-muted);margin-bottom:5px;}
.summary-card .value{font-family:'JetBrains Mono',monospace;font-size:20px;font-weight:600;}
.value.positive{color:var(--green);} .value.negative{color:var(--red);}

.section-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}
.section-hdr h2{font-size:16px;font-weight:600;}
.section-hdr .hint{font-size:12px;color:var(--text-muted);}

.filter-bar{display:flex;gap:8px;flex-wrap:wrap;padding:10px 14px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px 10px 0 0;border-bottom:none;align-items:center;}
.filter-bar select,.filter-bar input{background:var(--bg);border:1px solid var(--border-light);color:var(--text);padding:5px 9px;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:13px;outline:none;}
.filter-bar select:focus,.filter-bar input:focus{border-color:var(--cyan);}
.filter-bar input{width:180px;}
.filter-spacer{flex:1;}
.filter-count{font-size:11px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;}

.table-wrap{background:var(--bg-card);border:1px solid var(--border);border-radius:0 0 10px 10px;overflow:hidden;}
.table-wrap.standalone{border-radius:10px;}
.table-scroll{max-height:calc(100vh - 280px);overflow-y:auto;}
table{width:100%;border-collapse:collapse;}
th{padding:9px 13px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg);font-weight:500;white-space:nowrap;cursor:pointer;user-select:none;}
th:hover{color:var(--text-dim);} th.sorted{color:var(--cyan);}
td{padding:8px 13px;border-bottom:1px solid var(--border);vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:var(--bg-hover);}
tr.editing td{background:rgba(6,182,212,0.04);}

.acct-badge{display:inline-block;padding:2px 7px;border-radius:4px;font-size:11px;font-family:'JetBrains Mono',monospace;font-weight:600;}
.acct-USAA{background:rgba(59,130,246,0.15);color:#60a5fa;}
.acct-SUN{background:rgba(245,158,11,0.15);color:#fbbf24;}
.acct-SID,.acct-NBT,.acct-DVA{background:rgba(100,116,139,0.15);color:#94a3b8;}
.cat-badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;background:var(--bg-hover);color:var(--text-dim);border:1px solid var(--border-light);}
.cat-badge.uncat{color:var(--amber);border-color:rgba(245,158,11,0.3);background:var(--amber-bg);}

.amt-pos{color:var(--green);font-family:'JetBrains Mono',monospace;font-size:13px;}
.amt-neg{color:var(--red);font-family:'JetBrains Mono',monospace;font-size:13px;}
.amt-dim{color:var(--text-dim);font-family:'JetBrains Mono',monospace;font-size:12px;}
.date-cell{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text-dim);white-space:nowrap;}
.desc-main{color:var(--text);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:240px;}
.desc-orig{font-size:11px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:240px;margin-top:1px;}

.btn{padding:4px 10px;border-radius:5px;border:1px solid var(--border-light);background:transparent;color:var(--text-muted);font-size:12px;cursor:pointer;transition:all .15s;white-space:nowrap;font-family:'DM Sans',sans-serif;}
.btn:hover{color:var(--cyan);border-color:var(--cyan);}
.btn-save{border-color:rgba(34,197,94,0.4);background:var(--green-bg);color:var(--green);}
.btn-save:hover{background:rgba(34,197,94,0.15);}
.btn-danger{border-color:rgba(239,68,68,0.3);color:var(--red);}
.btn-danger:hover{background:var(--red-bg);border-color:var(--red);}
.btn-primary{background:var(--cyan-bg);border-color:rgba(6,182,212,0.4);color:var(--cyan);}
.btn-primary:hover{background:rgba(6,182,212,0.15);}
.btn-amber{border-color:rgba(245,158,11,0.3);color:var(--amber);}
.btn-amber:hover{background:var(--amber-bg);}

.inline-input{background:var(--bg);border:1px solid var(--cyan);color:var(--text);padding:4px 8px;border-radius:5px;font-size:13px;font-family:'DM Sans',sans-serif;width:100%;outline:none;}
.inline-select{background:var(--bg);border:1px solid var(--cyan);color:var(--text);padding:4px 8px;border-radius:5px;font-size:12px;font-family:'DM Sans',sans-serif;outline:none;}

.loading{text-align:center;padding:40px;color:var(--text-muted);}
.empty{text-align:center;padding:60px;color:var(--text-muted);font-size:13px;}

.pagination{display:flex;align-items:center;gap:8px;padding:10px 14px;border-top:1px solid var(--border);font-size:12px;color:var(--text-dim);}
.page-btn{padding:3px 10px;border:1px solid var(--border);border-radius:5px;background:transparent;color:var(--text-dim);cursor:pointer;font-size:12px;}
.page-btn:hover:not(:disabled){border-color:var(--cyan);color:var(--cyan);}
.page-btn:disabled{opacity:.3;cursor:default;}

.bills-summary{display:flex;gap:12px;margin-bottom:14px;}
.bills-stat{background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:10px 16px;flex:1;}
.bills-stat .lbl{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);}
.bills-stat .val{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:600;margin-top:2px;}

.merge-select{background:var(--bg);border:1px solid var(--border-light);color:var(--text);padding:4px 8px;border-radius:5px;font-size:12px;font-family:'DM Sans',sans-serif;outline:none;max-width:160px;}
.merge-select:focus{border-color:var(--amber);}

.month-nav{display:flex;align-items:center;gap:8px;}
.month-nav select{background:var(--bg-card);border:1px solid var(--border);color:var(--text);padding:5px 10px;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:13px;}

/* Forecast specific */
.forecast-controls{display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;}
.forecast-controls select{background:var(--bg-card);border:1px solid var(--border);color:var(--text);padding:6px 12px;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:13px;}
.forecast-stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:20px;}
.forecast-stat{background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:12px 16px;}
.forecast-stat .lbl{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:4px;}
.forecast-stat .val{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:600;}
.forecast-stat .sub{font-size:11px;color:var(--text-muted);margin-top:2px;}
.forecast-timeline{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
.forecast-day{display:grid;grid-template-columns:90px 100px 120px 1fr;gap:0;border-bottom:1px solid var(--border);padding:0;}
.forecast-day:last-child{border-bottom:none;}
.forecast-day.today{background:rgba(6,182,212,0.04);}
.forecast-day.has-events{background:var(--bg-hover);}
.forecast-day.negative .fd-bal{color:var(--red)!important;}
.forecast-day.warning .fd-bal{color:var(--amber)!important;}
.fd-date{padding:10px 14px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text-dim);border-right:1px solid var(--border);display:flex;align-items:center;}
.fd-date.today-label{color:var(--cyan);font-weight:600;}
.fd-change{padding:10px 14px;font-family:'JetBrains Mono',monospace;font-size:12px;text-align:right;border-right:1px solid var(--border);display:flex;align-items:center;justify-content:flex-end;}
.fd-bal{padding:10px 14px;font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;color:var(--green);border-right:1px solid var(--border);display:flex;align-items:center;justify-content:flex-end;}
.fd-events{padding:8px 14px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;}
.event-pill{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:4px;font-size:11px;}
.event-bill{background:rgba(239,68,68,0.12);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);}
.event-income{background:rgba(34,197,94,0.12);color:#86efac;border:1px solid rgba(34,197,94,0.2);}
.forecast-alert{padding:12px 16px;border-radius:8px;margin-bottom:14px;font-size:13px;display:flex;align-items:center;gap:8px;}
.forecast-alert.danger{background:var(--red-bg);border:1px solid rgba(239,68,68,0.3);color:var(--red);}
.forecast-alert.warning{background:var(--amber-bg);border:1px solid rgba(245,158,11,0.3);color:var(--amber);}
.forecast-alert.ok{background:var(--green-bg);border:1px solid rgba(34,197,94,0.3);color:var(--green);}

.toast{position:fixed;bottom:24px;right:24px;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:10px 16px;font-size:13px;z-index:999;animation:fadeIn .2s;}
.toast.ok{border-color:rgba(34,197,94,0.4);color:var(--green);}
.toast.err{border-color:rgba(239,68,68,0.4);color:var(--red);}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-left">
    <div style="font-family:'Cinzel',serif;font-size:16px;font-weight:600;letter-spacing:4px;color:#d4a574">MYTHOS</div>
    <nav class="topbar-nav">
      <a href="/app/">Home</a>
      <a href="/app/finance/" class="active">Finance</a>
      <a href="/app/people/">People</a>
      <a href="/app/ontology/">Ontology</a>
    <a href="/app/quotes/">Quotes</a>
    <a href="/app/system/">System</a>
      <a href="/app/sessions/">Sessions</a>
      <a href="/app/registry/">Registry</a>
    </nav>
  </div>
  <div class="topbar-right">
    <span class="user-info" id="user-info"></span>
    <a href="/auth/logout" class="logout-btn">logout</a>
  </div>
</div>

<div class="app-body">
  <nav class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-label">Finance</div>
      <button class="sidebar-item active" onclick="showSection('overview')" id="nav-overview"><span class="icon">◈</span> Overview</button>
      <button class="sidebar-item" onclick="showSection('transactions')" id="nav-transactions"><span class="icon">⇄</span> Transactions</button>
      <button class="sidebar-item" onclick="showSection('bills')" id="nav-bills"><span class="icon">📅</span> Bills</button>
      <button class="sidebar-item" onclick="showSection('forecast')" id="nav-forecast"><span class="icon">📈</span> Forecast</button>
    </div>
    <hr class="sidebar-divider">
    <div class="sidebar-section">
      <div class="sidebar-label">Manage</div>
      <button class="sidebar-item" onclick="showSection('categories')" id="nav-categories"><span class="icon">🏷</span> Categories</button>
      <button class="sidebar-item" onclick="showSection('accounts')" id="nav-accounts"><span class="icon">🏦</span> Accounts</button>
    </div>
  </nav>

  <div class="main" id="main"><div class="loading">Loading...</div></div>
</div>

<div class="toast" id="toast" style="display:none"></div>

<script>
// ── State ──────────────────────────────────────────────────
let categories = [], accounts = [];
let allTxns = [], filteredTxns = [];
let txnSortCol = 'transaction_date', txnSortDir = -1;
let txnPage = 0; const PAGE_SIZE = 50;
let editingTxnId = null;
let billMonth = currMonth();
let forecastAccount = 'combined', forecastDays = 30;

function currMonth() {
  const n = new Date();
  return `${n.getFullYear()}-${String(n.getMonth()+1).padStart(2,'0')}`;
}

// ── Utils ──────────────────────────────────────────────────
function fmt(n) {
  if (n===null||n===undefined) return '—';
  const abs = Math.abs(n);
  const s = abs.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  return n<0 ? `-$${s}` : `$${s}`;
}
function esc(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function toast(msg, type='ok') {
  const el = document.getElementById('toast');
  el.textContent=msg; el.className=`toast ${type}`; el.style.display='block';
  setTimeout(()=>{el.style.display='none';},3000);
}
function monthOpts(sel) {
  const n = new Date(); let o = '';
  for (let i=0;i<12;i++) {
    const d = new Date(n.getFullYear(),n.getMonth()-i,1);
    const k = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
    const lbl = d.toLocaleString('en-US',{month:'long',year:'numeric'});
    o += `<option value="${k}" ${k===sel?'selected':''}>${lbl}</option>`;
  }
  return o;
}

// ── Init ───────────────────────────────────────────────────
fetch('/auth/me').then(r=>r.json()).then(d=>{
  document.getElementById('user-info').textContent=d.name||d.email;
}).catch(()=>{window.location.href='/app/login';});

fetch('/api/finance/categories').then(r=>r.json()).then(d=>{categories=d.categories||[];});

showSection('overview');

// ── Nav ────────────────────────────────────────────────────
function showSection(name) {
  document.querySelectorAll('.sidebar-item').forEach(el=>el.classList.remove('active'));
  const nav = document.getElementById(`nav-${name}`);
  if (nav) nav.classList.add('active');
  const main = document.getElementById('main');
  main.innerHTML='<div class="loading">Loading...</div>';
  ({overview:renderOverview,transactions:renderTransactions,bills:renderBills,
    forecast:renderForecast,categories:renderCategories,accounts:renderAccounts}[name]||renderOverview)();
}

// ══════════════════════════════════════════════════════════
// OVERVIEW
// ══════════════════════════════════════════════════════════
function renderOverview() {
  fetch('/api/finance/summary').then(r=>r.json()).then(data=>{
    document.getElementById('main').innerHTML = `
      <div class="summary-row" id="sum-cards"></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:8px">
        <div><div class="section-hdr"><h2>This Month's Bills</h2><span class="hint" id="bills-hint"></span></div><div id="bills-mini"><div class="loading">Loading...</div></div></div>
        <div><div class="section-hdr"><h2>Spending by Category</h2></div><div id="spend-mini"><div class="loading">Loading...</div></div></div>
      </div>`;
    document.getElementById('sum-cards').innerHTML = `
      <div class="summary-card"><div class="label">USAA</div><div class="value ${(data.balances.USAA||0)>=0?'positive':'negative'}">${fmt(data.balances.USAA||0)}</div></div>
      <div class="summary-card"><div class="label">Sunmark</div><div class="value ${(data.balances.SUN||0)>=0?'positive':'negative'}">${fmt(data.balances.SUN||0)}</div></div>
      <div class="summary-card"><div class="label">Combined</div><div class="value ${data.combined>=0?'positive':'negative'}">${fmt(data.combined)}</div></div>
      <div class="summary-card"><div class="label">Month Income</div><div class="value positive">${fmt(data.month_income)}</div></div>
      <div class="summary-card"><div class="label">Month Spending</div><div class="value negative">${fmt(data.month_spending)}</div></div>
      <div class="summary-card"><div class="label">Month Net</div><div class="value ${data.month_net>=0?'positive':'negative'}">${fmt(data.month_net)}</div></div>`;
    fetch(`/api/finance/bills/tracker?month=${currMonth()}`).then(r=>r.json()).then(d=>{
      document.getElementById('bills-hint').textContent=`${d.paid_count}/${d.bills.length} paid`;
      const rows=d.bills.slice(0,8).map(b=>`<tr>
        <td style="padding:5px 10px;font-size:13px">${b.status==='paid'?'✅':(b.overdue?'🔴':'⬜')}</td>
        <td style="padding:5px 10px;font-size:13px">${esc(b.merchant_name)}</td>
        <td style="padding:5px 10px;font-family:'JetBrains Mono',monospace;font-size:12px;text-align:right;color:var(--text-dim)">${fmt(b.expected_amount)}</td>
        <td style="padding:5px 10px;font-size:11px;color:var(--text-muted)">${b.due_date?`Due ${b.due_date.slice(5)}`:'As needed'}</td>
      </tr>`).join('');
      document.getElementById('bills-mini').innerHTML=`<div class="table-wrap standalone"><table><tbody>${rows}</tbody></table></div>
        ${d.bills.length>8?`<div style="padding:8px;font-size:12px;color:var(--text-muted);text-align:center">+${d.bills.length-8} more — <a href="#" onclick="showSection('bills');return false" style="color:var(--cyan)">View all</a></div>`:''}`;
    });
    fetch(`/api/finance/spending?month=${currMonth()}`).then(r=>r.json()).then(d=>{
      const rows=d.categories.filter(c=>c.total<0).sort((a,b)=>a.total-b.total).slice(0,8).map(c=>`<tr>
        <td style="padding:5px 10px;font-size:13px">${esc(c.category_primary||'Uncategorized')}</td>
        <td style="padding:5px 10px;font-family:'JetBrains Mono',monospace;font-size:12px;text-align:right;color:var(--red)">${fmt(c.total)}</td>
        <td style="padding:5px 10px;font-size:11px;color:var(--text-muted);text-align:right">${c.txn_count} txns</td>
      </tr>`).join('');
      document.getElementById('spend-mini').innerHTML=`<div class="table-wrap standalone"><table><tbody>${rows}</tbody></table></div>`;
    });
  });
}

// ══════════════════════════════════════════════════════════
// TRANSACTIONS
// ══════════════════════════════════════════════════════════
function renderTransactions() {
  document.getElementById('main').innerHTML = `
    <div class="section-hdr"><h2>Transactions</h2><span class="hint">Click Edit to modify description or category</span></div>
    <div class="filter-bar">
      <select id="f-month">${monthOpts(currMonth())}</select>
      <select id="f-account"><option value="">All accounts</option><option value="USAA">USAA</option><option value="SUN">Sunmark</option></select>
      <select id="f-cat">
        <option value="">All categories</option>
        <option value="__uncategorized__">⚠ Uncategorized</option>
        ${categories.map(c=>`<option value="${esc(c.category_primary||c)}">${esc(c.category_primary||c)}</option>`).join('')}
      </select>
      <input type="text" id="f-search" placeholder="Search..." />
      <div class="filter-spacer"></div>
      <span class="filter-count" id="txn-count"></span>
      <button class="btn" onclick="clearTxnFilters()">Clear</button>
    </div>
    <div class="table-wrap">
      <div class="table-scroll">
        <table>
          <thead><tr>
            <th onclick="txnSort('transaction_date')">Date</th>
            <th>Acct</th><th>Description</th>
            <th onclick="txnSort('category_primary')">Category</th>
            <th onclick="txnSort('amount')" style="text-align:right">Amount</th>
            <th style="text-align:right">Balance</th><th></th>
          </tr></thead>
          <tbody id="txn-body"><tr><td colspan="7" class="loading">Loading...</td></tr></tbody>
        </table>
      </div>
      <div class="pagination" id="txn-pag" style="display:none">
        <button class="page-btn" id="txn-prev" onclick="txnPrev()">← Prev</button>
        <span id="txn-pi"></span>
        <button class="page-btn" id="txn-next" onclick="txnNext()">Next →</button>
      </div>
    </div>`;
  loadTxns();
  let st;
  document.getElementById('f-search').addEventListener('input',()=>{clearTimeout(st);st=setTimeout(loadTxns,400);});
  ['f-month','f-account','f-cat'].forEach(id=>document.getElementById(id).addEventListener('change',loadTxns));
}

function loadTxns() {
  const m=document.getElementById('f-month')?.value||'';
  const a=document.getElementById('f-account')?.value||'';
  const c=document.getElementById('f-cat')?.value||'';
  const s=document.getElementById('f-search')?.value||'';
  let url=`/api/finance/transactions?limit=500`;
  if(m) url+=`&month=${m}`; if(a) url+=`&account=${a}`;
  if(c) url+=`&category=${encodeURIComponent(c)}`; if(s) url+=`&search=${encodeURIComponent(s)}`;
  document.getElementById('txn-body').innerHTML='<tr><td colspan="7" class="loading">Loading...</td></tr>';
  fetch(url).then(r=>r.json()).then(d=>{
    allTxns=d.transactions; filteredTxns=[...allTxns]; txnPage=0; txnApplySort(); txnRender();
  }).catch(e=>{document.getElementById('txn-body').innerHTML=`<tr><td colspan="7" class="empty" style="color:var(--red)">Error: ${e.message}</td></tr>`;});
}

function clearTxnFilters() {
  ['f-month','f-account','f-cat','f-search'].forEach(id=>{const el=document.getElementById(id);if(el){el.value=id==='f-month'?currMonth():'';} }); loadTxns();
}
function txnSort(col) { if(txnSortCol===col)txnSortDir*=-1; else{txnSortCol=col;txnSortDir=-1;} txnApplySort();txnRender(); }
function txnApplySort() {
  filteredTxns=[...allTxns].sort((a,b)=>{
    let av=a[txnSortCol],bv=b[txnSortCol];
    if(av===null||av===undefined)av=''; if(bv===null||bv===undefined)bv='';
    if(typeof av==='number') return txnSortDir*(av-bv);
    return txnSortDir*String(av).localeCompare(String(bv));
  });
}
function txnPrev(){if(txnPage>0){txnPage--;txnRender();}}
function txnNext(){txnPage++;txnRender();}
function txnRender() {
  const start=txnPage*PAGE_SIZE,end=start+PAGE_SIZE,page=filteredTxns.slice(start,end),total=filteredTxns.length;
  const ce=document.getElementById('txn-count'); if(ce)ce.textContent=`${total} transactions`;
  if(total===0){document.getElementById('txn-body').innerHTML='<tr><td colspan="7" class="empty">No transactions found</td></tr>';const p=document.getElementById('txn-pag');if(p)p.style.display='none';return;}
  document.getElementById('txn-body').innerHTML=page.map(t=>{
    const cc=t.category_primary?'':'uncat',cl=t.category_primary||'Uncategorized',ac=t.amount>=0?'amt-pos':'amt-neg';
    const orig=t.original_description?`<div class="desc-orig" title="${esc(t.original_description)}">${esc(t.original_description)}</div>`:'';
    return `<tr data-id="${t.id}">
      <td class="date-cell">${t.transaction_date}</td>
      <td><span class="acct-badge acct-${esc(t.account)}">${esc(t.account)}</span></td>
      <td style="max-width:260px"><div class="desc-main" title="${esc(t.description)}">${esc(t.description)}</div>${orig}</td>
      <td><span class="cat-badge ${cc}">${esc(cl)}</span></td>
      <td style="text-align:right"><span class="${ac}">${fmt(t.amount)}</span></td>
      <td style="text-align:right"><span class="amt-dim">${fmt(t.balance)}</span></td>
      <td style="text-align:right"><button class="btn" onclick="txnEdit(${t.id})">Edit</button></td>
    </tr>`;
  }).join('');
  const tp=Math.ceil(total/PAGE_SIZE),pg=document.getElementById('txn-pag');
  if(pg){if(tp>1){pg.style.display='flex';document.getElementById('txn-pi').textContent=`Page ${txnPage+1} of ${tp}`;document.getElementById('txn-prev').disabled=txnPage===0;document.getElementById('txn-next').disabled=txnPage>=tp-1;}else pg.style.display='none';}
}
function txnEdit(id) {
  if(editingTxnId&&editingTxnId!==id)txnCancel();
  editingTxnId=id;
  const t=allTxns.find(x=>x.id===id); if(!t)return;
  const row=document.querySelector(`tr[data-id="${id}"]`); if(!row)return;
  row.classList.add('editing');
  const catOpts=`<option value="">— Uncategorized —</option>`+categories.map(c=>{const cv=c.category_primary||c;return`<option value="${esc(cv)}" ${cv===t.category_primary?'selected':''}>${esc(cv)}</option>`;}).join('');
  row.innerHTML=`
    <td class="date-cell">${t.transaction_date}</td>
    <td><span class="acct-badge acct-${esc(t.account)}">${esc(t.account)}</span></td>
    <td style="min-width:200px"><input class="inline-input" id="edit-desc" value="${esc(t.description)}" /><div class="desc-orig" style="margin-top:3px">${esc(t.original_description||'')}</div></td>
    <td><select class="inline-select" id="edit-cat">${catOpts}</select></td>
    <td style="text-align:right"><span class="${t.amount>=0?'amt-pos':'amt-neg'}">${fmt(t.amount)}</span></td>
    <td style="text-align:right"><span class="amt-dim">${fmt(t.balance)}</span></td>
    <td style="text-align:right;white-space:nowrap"><button class="btn btn-save" onclick="txnSave(${id})">Save</button><button class="btn" onclick="txnCancel()" style="margin-left:4px">✕</button></td>`;
  const d=document.getElementById('edit-desc'); d.focus();
  d.addEventListener('keydown',e=>{if(e.key==='Enter')txnSave(id);if(e.key==='Escape')txnCancel();});
}
function txnCancel(){editingTxnId=null;txnRender();}
async function txnSave(id) {
  const desc=document.getElementById('edit-desc')?.value?.trim();
  const cat=document.getElementById('edit-cat')?.value;
  if(!desc){toast('Description required','err');return;}
  try {
    const r=await fetch(`/api/finance/transactions/${id}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({description:desc,category_primary:cat||null})});
    if(!r.ok) throw new Error(await r.text());
    const t=allTxns.find(x=>x.id===id); if(t){t.description=desc;t.category_primary=cat||null;}
    editingTxnId=null; txnRender(); toast('Saved ✓');
  } catch(e){toast('Save failed','err');}
}

// ══════════════════════════════════════════════════════════
// BILLS
// ══════════════════════════════════════════════════════════
function renderBills() {
  document.getElementById('main').innerHTML=`
    <div class="section-hdr"><h2>Bills Tracker</h2><div class="month-nav"><select id="bills-month" onchange="loadBills()">${monthOpts(billMonth)}</select></div></div>
    <div class="bills-summary" id="bills-sum"></div>
    <div class="table-wrap standalone"><div class="table-scroll" style="max-height:calc(100vh - 280px)">
      <table><thead><tr>
        <th style="width:36px">Status</th><th>Bill</th><th>Expected</th>
        <th>Due</th><th>Paid Amt</th><th>Paid Date</th><th>Matched To</th><th></th>
      </tr></thead>
      <tbody id="bills-body"><tr><td colspan="8" class="loading">Loading...</td></tr></tbody></table>
    </div></div>`;
  loadBills();
}

function loadBills() {
  const mel=document.getElementById('bills-month'); billMonth=mel?mel.value:currMonth();
  fetch(`/api/finance/bills/tracker?month=${billMonth}`).then(r=>r.json()).then(d=>{
    document.getElementById('bills-sum').innerHTML=`
      <div class="bills-stat"><div class="lbl">Total Expected</div><div class="val" style="color:var(--text)">${fmt(d.total_expected)}</div></div>
      <div class="bills-stat"><div class="lbl">Paid</div><div class="val positive">${fmt(d.total_paid)}</div></div>
      <div class="bills-stat"><div class="lbl">Remaining</div><div class="val negative">${fmt(d.total_expected-d.total_paid)}</div></div>
      <div class="bills-stat"><div class="lbl">Bills Paid</div><div class="val" style="color:var(--cyan)">${d.paid_count} / ${d.bills.length}</div></div>`;
    document.getElementById('bills-body').innerHTML=d.bills.map(b=>{
      const icon=b.status==='paid'?'✅':(b.overdue?'🔴':'⬜');
      const hasOverride=!!b.override;
      const paidAmt=b.override_paid_amount??b.matched_amount;
      const paidDate=b.override_paid_date??b.matched_date;
      const matchDesc=b.matched_description?`<span style="font-size:11px;color:var(--text-muted)">${esc(b.matched_description)}</span>`:'—';
      const dueText=b.due_date?b.due_date.slice(5):(b.frequency==='as-needed'?'As needed':'—');
      const overrideTag=hasOverride?'<span style="font-size:10px;color:var(--amber);margin-left:4px">manual</span>':'';
      const actionBtn=b.status==='paid'
        ?`<button class="btn btn-danger" style="font-size:11px" onclick="billOverride(${b.id},false)">Mark Unpaid</button>`
        :`<button class="btn btn-primary" style="font-size:11px" onclick="billOverride(${b.id},true)">Mark Paid</button>`;
      const clearBtn=hasOverride?`<button class="btn" style="font-size:11px;margin-left:4px" onclick="billClear(${b.id})">Reset</button>`:'';
      return `<tr>
        <td style="text-align:center">${icon}${overrideTag}</td>
        <td><strong>${esc(b.merchant_name)}</strong>${b.notes?`<div style="font-size:11px;color:var(--text-muted)">${esc(b.notes)}</div>`:''}</td>
        <td class="amt-dim">${fmt(b.expected_amount)}</td>
        <td class="date-cell">${dueText}</td>
        <td class="${paidAmt?'amt-pos':'amt-dim'}">${paidAmt?fmt(paidAmt):'—'}</td>
        <td class="date-cell">${paidDate?paidDate.slice?.(5)||paidDate:'—'}</td>
        <td>${matchDesc}</td>
        <td style="text-align:right;white-space:nowrap">${actionBtn}${clearBtn}</td>
      </tr>`;
    }).join('')||'<tr><td colspan="8" class="empty">No bills found</td></tr>';
  });
}

async function billOverride(id, paid) {
  try {
    const r=await fetch(`/api/finance/bills/${id}/override?month=${billMonth}`,{
      method:'PATCH',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({paid, paid_amount:null, paid_date:null})
    });
    if(!r.ok) throw new Error(await r.text());
    toast(paid?'Marked as paid ✓':'Marked as unpaid ✓'); loadBills();
  } catch(e){toast('Failed to save override','err');}
}

async function billClear(id) {
  try {
    const r=await fetch(`/api/finance/bills/${id}/override?month=${billMonth}`,{method:'DELETE'});
    if(!r.ok) throw new Error(await r.text());
    toast('Override cleared — reverted to auto-match'); loadBills();
  } catch(e){toast('Failed to clear override','err');}
}

// ══════════════════════════════════════════════════════════
// FORECAST
// ══════════════════════════════════════════════════════════
function renderForecast() {
  document.getElementById('main').innerHTML=`
    <div class="section-hdr"><h2>Balance Forecast</h2></div>
    <div class="forecast-controls">
      <select id="fc-account" onchange="loadForecast()">
        <option value="combined">USAA + Sunmark</option>
        <option value="USAA">USAA only</option>
        <option value="SUN">Sunmark only</option>
      </select>
      <select id="fc-days" onchange="loadForecast()">
        <option value="14">14 days</option>
        <option value="30" selected>30 days</option>
        <option value="45">45 days</option>
        <option value="60">60 days</option>
      </select>
    </div>
    <div id="fc-alert"></div>
    <div class="forecast-stat-row" id="fc-stats"></div>
    <div class="forecast-timeline" id="fc-timeline"><div class="loading">Loading...</div></div>`;
  loadForecast();
}

function loadForecast() {
  const acct=document.getElementById('fc-account')?.value||'combined';
  const days=document.getElementById('fc-days')?.value||'30';
  let url=`/api/finance/forecast?days=${days}`;
  if(acct!=='combined') url+=`&account=${acct}`;
  document.getElementById('fc-timeline').innerHTML='<div class="loading">Loading...</div>';

  fetch(url).then(r=>r.json()).then(d=>{
    if(d.error){document.getElementById('fc-timeline').innerHTML=`<div class="empty" style="color:var(--red)">${esc(d.error)}</div>`;return;}

    // Alert
    const alertEl=document.getElementById('fc-alert');
    if(d.went_negative){
      alertEl.innerHTML=`<div class="forecast-alert danger">⛔ Overdraft risk — goes negative on ${d.negative_date}. Lowest: ${fmt(d.lowest)}</div>`;
    } else if(d.lowest<200){
      alertEl.innerHTML=`<div class="forecast-alert warning">⚠️ Balance dips low — ${fmt(d.lowest)} on ${d.lowest_date}</div>`;
    } else {
      alertEl.innerHTML=`<div class="forecast-alert ok">✅ Looks healthy — lowest balance: ${fmt(d.lowest)} on ${d.lowest_date}</div>`;
    }

    // Stats
    document.getElementById('fc-stats').innerHTML=`
      <div class="forecast-stat"><div class="lbl">Starting</div><div class="val" style="color:var(--text)">${fmt(d.starting)}</div></div>
      <div class="forecast-stat"><div class="lbl">Ending</div><div class="val ${d.ending>=0?'positive':'negative'}">${fmt(d.ending)}</div></div>
      <div class="forecast-stat"><div class="lbl">Lowest</div><div class="val ${d.lowest>=200?'positive':d.lowest>=0?'':'negative'}" style="${d.lowest<200&&d.lowest>=0?'color:var(--amber)':''}">${fmt(d.lowest)}</div><div class="sub">${d.lowest_date}</div></div>
      <div class="forecast-stat"><div class="lbl">Change</div><div class="val ${(d.ending-d.starting)>=0?'positive':'negative'}">${fmt(d.ending-d.starting)}</div></div>`;

    // Timeline — only show days with events + today + last day
    const today = new Date().toISOString().slice(0,10);
    const lastIdx = d.days.length - 1;
    const rows = d.days.filter((dd,i)=>dd.bills.length||dd.income.length||i===0||i===lastIdx).map(dd=>{
      const isToday=dd.date===today;
      const isNeg=dd.running<0;
      const isWarn=dd.running>=0&&dd.running<200;
      const cls=[isToday?'today':'',dd.bills.length||dd.income.length?'has-events':'',isNeg?'negative':'',isWarn?'warning':''].filter(Boolean).join(' ');
      const dateLabel=isToday?'TODAY':dd.date.slice(5);
      const changeStr=dd.day_change===0?'':(dd.day_change>0?`<span style="color:var(--green)">+${fmt(dd.day_change)}</span>`:`<span style="color:var(--red)">${fmt(dd.day_change)}</span>`);
      const events=[
        ...dd.income.map(i=>`<span class="event-pill event-income">💰 ${esc(i.source)} ${fmt(i.amount)}</span>`),
        ...dd.bills.map(b=>`<span class="event-pill event-bill">💸 ${esc(b.merchant)} ${fmt(b.amount)}</span>`)
      ].join('');
      return `<div class="forecast-day ${cls}">
        <div class="fd-date ${isToday?'today-label':''}">${dateLabel}</div>
        <div class="fd-change">${changeStr}</div>
        <div class="fd-bal" style="${isNeg?'color:var(--red)':isWarn?'color:var(--amber)':''}">${fmt(dd.running)}</div>
        <div class="fd-events">${events}</div>
      </div>`;
    }).join('');
    document.getElementById('fc-timeline').innerHTML=rows||'<div class="empty">No forecast data</div>';
  }).catch(e=>{
    document.getElementById('fc-timeline').innerHTML=`<div class="empty" style="color:var(--red)">Error: ${e.message}</div>`;
  });
}

// ══════════════════════════════════════════════════════════
// CATEGORIES
// ══════════════════════════════════════════════════════════
function renderCategories() {
  document.getElementById('main').innerHTML=`
    <div class="section-hdr"><h2>Categories</h2>
      <div style="display:flex;gap:8px;align-items:center">
        <input id="new-cat" class="inline-input" style="width:180px" placeholder="New category name..." />
        <button class="btn btn-primary" onclick="addCat()">+ Add</button>
      </div>
    </div>
    <div class="table-wrap standalone"><div class="table-scroll" style="max-height:calc(100vh - 200px)">
      <table><thead><tr><th>Category</th><th style="text-align:right">Transactions</th><th>Rename To</th><th>Merge Into</th><th></th></tr></thead>
      <tbody id="cat-body"><tr><td colspan="5" class="loading">Loading...</td></tr></tbody></table>
    </div></div>`;
  document.getElementById('new-cat').addEventListener('keydown',e=>{if(e.key==='Enter')addCat();});
  loadCats();
}
function loadCats() {
  fetch('/api/finance/categories').then(r=>r.json()).then(d=>{
    categories=d.categories;
    document.getElementById('cat-body').innerHTML=d.categories.map(c=>{
      const n=c.category_primary;
      const others=d.categories.filter(x=>x.category_primary!==n).map(x=>`<option value="${esc(x.category_primary)}">${esc(x.category_primary)}</option>`).join('');
      return `<tr>
        <td><span class="cat-badge">${esc(n)}</span></td>
        <td style="text-align:right;color:var(--text-dim);font-family:'JetBrains Mono',monospace;font-size:12px">${c.txn_count}</td>
        <td><div style="display:flex;gap:6px"><input class="inline-input" id="rn-${esc(n)}" style="width:150px" placeholder="${esc(n)}" /><button class="btn btn-save" onclick="renameCat('${esc(n)}')">Rename</button></div></td>
        <td><div style="display:flex;gap:6px"><select class="merge-select" id="mg-${esc(n)}"><option value="">Select target...</option>${others}</select><button class="btn btn-amber" onclick="mergeCat('${esc(n)}')">Merge</button></div></td>
        <td style="text-align:right"><button class="btn btn-danger" onclick="deleteCat('${esc(n)}',${c.txn_count})">Delete</button></td>
      </tr>`;
    }).join('')||'<tr><td colspan="5" class="empty">No categories found</td></tr>';
  });
}
function addCat(){const i=document.getElementById('new-cat');const n=i?.value?.trim();if(!n)return;toast(`Category "${n}" ready — assign it to transactions`);if(i)i.value='';}
async function renameCat(old) {
  const i=document.getElementById(`rn-${old}`);const n=i?.value?.trim();
  if(!n){toast('Enter new name','err');return;} if(n===old){toast('Same name','err');return;}
  const r=await fetch('/api/finance/categories/rename',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({old_name:old,new_name:n})});
  const d=await r.json(); toast(`Renamed "${old}" → "${n}" (${d.affected} transactions)`); loadCats();
}
async function mergeCat(src) {
  const s=document.getElementById(`mg-${src}`);const target=s?.value;
  if(!target){toast('Select a target','err');return;}
  if(!confirm(`Merge "${src}" into "${target}"? Cannot be undone.`))return;
  const r=await fetch('/api/finance/categories/merge',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({source:src,target})});
  const d=await r.json(); toast(`Merged "${src}" → "${target}" (${d.affected} transactions)`); loadCats();
}
async function deleteCat(name, count) {
  if(!confirm(`Delete "${name}"? ${count} transactions will become Uncategorized.`))return;
  const r=await fetch(`/api/finance/categories/${encodeURIComponent(name)}`,{method:'DELETE'});
  const d=await r.json(); toast(`Deleted "${name}" (${d.affected} uncategorized)`); loadCats();
}

// ══════════════════════════════════════════════════════════
// ACCOUNTS
// ══════════════════════════════════════════════════════════
function renderAccounts() {
  document.getElementById('main').innerHTML=`
    <div class="section-hdr"><h2>Accounts</h2><span class="hint">Update balances for accounts without auto-import</span></div>
    <div class="table-wrap standalone"><div class="table-scroll" style="max-height:calc(100vh - 180px)">
      <table><thead><tr><th>Account</th><th>Bank</th><th>Type</th><th style="text-align:right">Balance</th><th>Updated</th><th>Txns</th><th>New Balance</th><th></th></tr></thead>
      <tbody id="acct-body"><tr><td colspan="8" class="loading">Loading...</td></tr></tbody></table>
    </div></div>`;
  loadAccounts();
}
function loadAccounts() {
  fetch('/api/finance/accounts').then(r=>r.json()).then(d=>{
    document.getElementById('acct-body').innerHTML=d.accounts.map(a=>{
      const bc=a.current_balance>=0?'amt-pos':'amt-neg';
      const upd=a.balance_updated_at?new Date(a.balance_updated_at).toLocaleDateString():'Never';
      return `<tr style="${a.is_active?'':'opacity:0.5'}">
        <td><strong>${esc(a.abbreviation)}</strong>${!a.is_active?'<span style="font-size:10px;color:var(--text-muted);margin-left:6px">inactive</span>':''}</td>
        <td style="color:var(--text-dim)">${esc(a.bank_name)}</td>
        <td style="font-size:12px;color:var(--text-dim)">${a.account_type}</td>
        <td style="text-align:right"><span class="${bc}">${fmt(a.current_balance)}</span></td>
        <td class="date-cell">${upd}</td>
        <td style="text-align:right;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text-dim)">${a.txn_count||0}</td>
        <td><input class="inline-input" id="bal-${a.id}" placeholder="${fmt(a.current_balance)}" style="width:140px" /></td>
        <td style="text-align:right"><button class="btn btn-save" onclick="updateBal(${a.id})">Update</button></td>
      </tr>`;
    }).join('')||'<tr><td colspan="8" class="empty">No accounts found</td></tr>';
    d.accounts.forEach(a=>{const el=document.getElementById(`bal-${a.id}`);if(el)el.addEventListener('keydown',e=>{if(e.key==='Enter')updateBal(a.id);});});
  });
}
async function updateBal(id) {
  const i=document.getElementById(`bal-${id}`);const raw=i?.value?.trim().replace(/[$,]/g,'');
  if(!raw){toast('Enter amount','err');return;}
  const bal=parseFloat(raw);if(isNaN(bal)){toast('Invalid amount','err');return;}
  const r=await fetch(`/api/finance/accounts/${id}/balance`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({current_balance:bal})});
  const d=await r.json(); toast(`${d.abbreviation} updated to ${fmt(bal)}`); if(i)i.value=''; loadAccounts();
}
</script>
</body>
</html>
