<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mythos — People</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=JetBrains+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.30.4/cytoscape.min.js"></script>
<style>
:root {
  --bg:#0a0e17; --bg-card:#111827; --bg-hover:#1a2332;
  --border:#1e293b; --border-light:#293548;
  --text:#e2e8f0; --text-dim:#64748b; --text-muted:#475569;
  --green:#22c55e; --green-bg:rgba(34,197,94,0.08);
  --red:#ef4444; --red-bg:rgba(239,68,68,0.08);
  --amber:#f59e0b; --amber-bg:rgba(245,158,11,0.08);
  --blue:#3b82f6; --blue-bg:rgba(59,130,246,0.08);
  --cyan:#06b6d4; --cyan-bg:rgba(6,182,212,0.08);
  --purple:#a855f7; --purple-bg:rgba(168,85,247,0.08);
  --rose:#f43f5e; --rose-bg:rgba(244,63,94,0.08);
  --gold:#d4a574; --gold-bg:rgba(212,165,116,0.12);
  --sidebar-w:200px;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;display:flex;flex-direction:column;height:100vh;overflow:hidden;}
.topbar{display:flex;justify-content:space-between;align-items:center;padding:12px 24px;border-bottom:1px solid var(--border);background:var(--bg-card);flex-shrink:0;z-index:20;}
.topbar-left{display:flex;align-items:center;gap:20px;}
.topbar-logo{font-family:'Cinzel',serif;font-size:16px;font-weight:600;letter-spacing:4px;color:var(--gold);}
.topbar-nav{display:flex;gap:4px;}
.topbar-nav a{padding:6px 14px;border-radius:6px;color:var(--text-dim);text-decoration:none;font-size:13px;font-weight:500;transition:all .15s;}
.topbar-nav a:hover{color:var(--text);background:var(--bg-hover);}
.topbar-nav a.active{color:var(--cyan);background:var(--cyan-bg);}
.topbar-right{display:flex;align-items:center;gap:12px;}
.user-info{font-size:12px;color:var(--text-dim);}
.logout-btn{padding:5px 12px;border:1px solid var(--border);border-radius:5px;background:transparent;color:var(--text-muted);font-size:12px;cursor:pointer;text-decoration:none;}
.hamburger{display:none;background:none;border:1px solid var(--border);border-radius:6px;color:var(--text-dim);padding:6px 10px;font-size:18px;cursor:pointer;line-height:1;}
.app-body{display:flex;flex:1;overflow:hidden;position:relative;}
.sidebar{width:var(--sidebar-w);background:var(--bg-card);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;padding:16px 0;z-index:15;overflow-y:auto;}
.sidebar-section{padding:0 12px;margin-bottom:4px;}
.sidebar-label{font-size:10px;text-transform:uppercase;letter-spacing:1.2px;color:var(--text-muted);padding:8px 8px 4px;}
.sidebar-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:7px;cursor:pointer;color:var(--text-dim);font-size:13px;font-weight:500;transition:all .15s;border:none;background:none;width:100%;text-align:left;}
.sidebar-item:hover{color:var(--text);background:var(--bg-hover);}
.sidebar-item.active{color:var(--rose);background:var(--rose-bg);}
.sidebar-item .icon{font-size:15px;width:18px;text-align:center;}
.sidebar-divider{border:none;border-top:1px solid var(--border);margin:8px 12px;}
.sidebar-count{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-muted);margin-left:auto;}
.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99;}
.sidebar-overlay.open{display:block;}
.sidebar-nav-mobile{display:none;padding:0 12px;margin-bottom:12px;}
.sidebar-nav-mobile a{display:block;padding:10px 10px;border-radius:7px;color:var(--text-dim);text-decoration:none;font-size:14px;font-weight:500;}
.sidebar-nav-mobile a.active{color:var(--cyan);background:var(--cyan-bg);}
.main{flex:1;overflow-y:auto;padding:24px;}
.search-bar{display:flex;gap:8px;margin-bottom:16px;align-items:center;}
.search-input{flex:1;background:var(--bg);border:1px solid var(--border-light);color:var(--text);padding:8px 14px;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:14px;outline:none;}
.search-input:focus{border-color:var(--rose);}
.search-input::placeholder{color:var(--text-muted);}
.btn{padding:6px 14px;border-radius:6px;border:1px solid var(--border-light);background:transparent;color:var(--text-muted);font-size:12px;cursor:pointer;transition:all .15s;white-space:nowrap;font-family:'DM Sans',sans-serif;}
.btn:hover{color:var(--cyan);border-color:var(--cyan);}
.btn-primary{background:var(--rose-bg);border-color:rgba(244,63,94,0.4);color:var(--rose);}
.btn-primary:hover{background:rgba(244,63,94,0.15);}
.btn-save{border-color:rgba(34,197,94,0.4);background:var(--green-bg);color:var(--green);}
.btn-save:hover{background:rgba(34,197,94,0.15);}
.btn-danger{border-color:rgba(239,68,68,0.3);color:var(--red);}
.btn-danger:hover{background:var(--red-bg);border-color:var(--red);}
.btn-graph{border-color:rgba(168,85,247,0.4);background:var(--purple-bg);color:var(--purple);}
.btn-graph:hover{background:rgba(168,85,247,0.15);}
.table-wrap{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
.table-scroll{max-height:calc(100vh - 260px);overflow-y:auto;}
table{width:100%;border-collapse:collapse;}
th{padding:9px 13px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg);font-weight:500;white-space:nowrap;cursor:pointer;user-select:none;position:sticky;top:0;z-index:2;}
th.sorted{color:var(--rose);}
td{padding:8px 13px;border-bottom:1px solid var(--border);vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:var(--bg-hover);}
tr{cursor:pointer;}
.name-main{color:var(--text);font-size:13px;font-weight:500;}
.name-sub{font-size:11px;color:var(--text-muted);margin-top:1px;}
.date-cell{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text-dim);white-space:nowrap;}
.loc-cell{font-size:12px;color:var(--text-dim);}
.notes-cell{font-size:12px;color:var(--text-muted);max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.empty{text-align:center;padding:60px 20px;color:var(--text-muted);font-size:13px;}
.badge{display:inline-block;padding:2px 7px;border-radius:4px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;}
.badge-person{background:var(--cyan-bg);color:var(--cyan);border:1px solid rgba(6,182,212,0.25);}
.badge-entity{background:var(--purple-bg);color:var(--purple);border:1px solid rgba(168,85,247,0.25);}
.badge-soul,.badge-soul_person{background:var(--gold-bg);color:var(--gold);border:1px solid rgba(212,165,116,0.35);}
.badge-genealogy{background:var(--amber-bg);color:var(--amber);border:1px solid rgba(245,158,11,0.25);}
.badge-ptype{display:inline-block;padding:2px 6px;border-radius:3px;font-size:10px;color:var(--text-dim);border:1px solid var(--border);margin-left:4px;}
.card-list{display:none;flex-direction:column;gap:8px;}
.person-card{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:14px 16px;cursor:pointer;}
.person-card-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:2px;gap:8px;}
.person-card-name{font-size:14px;font-weight:500;color:var(--text);line-height:1.4;}
.person-card-age{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-muted);flex-shrink:0;}
.person-card-meta{font-size:12px;color:var(--text-dim);margin-top:2px;}
.mobile-sort{display:none;gap:6px;margin-bottom:8px;align-items:center;flex-wrap:wrap;}
.detail-back{display:inline-flex;align-items:center;gap:6px;color:var(--text-dim);font-size:13px;cursor:pointer;margin-bottom:20px;background:none;border:none;font-family:'DM Sans',sans-serif;padding:6px 0;}
.detail-back:hover{color:var(--rose);}
.detail-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;gap:12px;}
.detail-name{font-family:'Cinzel',serif;font-size:24px;font-weight:600;letter-spacing:1px;color:var(--rose);}
.detail-sub{font-size:13px;color:var(--text-dim);margin-top:4px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.detail-actions{display:flex;gap:8px;flex-shrink:0;flex-wrap:wrap;}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;}
.field-group{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:20px;}
.field-group-title{font-size:11px;text-transform:uppercase;letter-spacing:1.2px;color:var(--text-muted);margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
.field-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;min-height:32px;gap:8px;}
.field-label{font-size:12px;color:var(--text-muted);flex-shrink:0;width:120px;}
.field-value{font-size:13px;color:var(--text);text-align:right;flex:1;word-break:break-word;}
.field-value.mono{font-family:'JetBrains Mono',monospace;font-size:12px;}
.field-value.empty-val{color:var(--text-muted);font-style:italic;font-size:12px;}
.field-input{background:var(--bg);border:1px solid var(--border-light);color:var(--text);padding:6px 8px;border-radius:5px;font-size:13px;font-family:'DM Sans',sans-serif;width:100%;max-width:200px;outline:none;text-align:right;}
.field-input:focus{border-color:var(--rose);}
.notes-section{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:16px;}
.notes-text{font-size:13px;color:var(--text-dim);line-height:1.7;white-space:pre-wrap;}
.rel-section{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:16px;}
.rel-item{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--border);font-size:13px;flex-wrap:wrap;}
.rel-item:last-child{border-bottom:none;}
.rel-type{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--cyan);background:var(--cyan-bg);padding:2px 6px;border-radius:3px;}
.rel-dir{font-size:11px;color:var(--text-muted);}
.rel-target{color:var(--text);cursor:pointer;}
.rel-target:hover{color:var(--rose);}
.rel-props{font-size:10px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;}
.rel-delete{font-size:11px;color:var(--red);cursor:pointer;margin-left:auto;opacity:0.5;padding:2px 6px;}
.rel-delete:hover{opacity:1;}
.rel-add-form{display:flex;gap:8px;padding-top:12px;border-top:1px solid var(--border);margin-top:8px;flex-wrap:wrap;align-items:center;}
.rel-add-form input,.rel-add-form select{background:var(--bg);border:1px solid var(--border-light);color:var(--text);padding:6px 8px;border-radius:5px;font-size:12px;font-family:'DM Sans',sans-serif;outline:none;}
.rel-add-form input:focus,.rel-add-form select:focus{border-color:var(--rose);}
.rel-search-results{position:absolute;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;max-height:200px;overflow-y:auto;z-index:50;width:250px;box-shadow:0 8px 24px rgba(0,0,0,0.4);}
.rel-search-item{padding:8px 12px;font-size:12px;cursor:pointer;display:flex;gap:6px;align-items:center;}
.rel-search-item:hover{background:var(--bg-hover);}
.alias-list{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px;}
.alias-tag{font-size:11px;padding:2px 6px;background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--text-dim);}
.detail-meta{margin-top:16px;font-size:11px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;}
.form-card{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:24px;max-width:700px;}
.form-title{font-family:'Cinzel',serif;font-size:18px;font-weight:600;color:var(--rose);margin-bottom:20px;letter-spacing:1px;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.form-field{display:flex;flex-direction:column;gap:4px;}
.form-field.full{grid-column:1/-1;}
.form-label{font-size:11px;text-transform:uppercase;letter-spacing:0.8px;color:var(--text-muted);}
.form-input,.form-select{background:var(--bg);border:1px solid var(--border-light);color:var(--text);padding:10px 12px;border-radius:6px;font-size:14px;font-family:'DM Sans',sans-serif;outline:none;}
.form-input:focus,.form-select:focus{border-color:var(--rose);}
.form-textarea{background:var(--bg);border:1px solid var(--border-light);color:var(--text);padding:10px 12px;border-radius:6px;font-size:14px;font-family:'DM Sans',sans-serif;outline:none;resize:vertical;min-height:100px;}
.form-actions{display:flex;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border);}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:10px 20px;font-size:13px;z-index:999;animation:fadeIn .2s;display:none;max-width:90vw;text-align:center;}
.toast.ok{border-color:rgba(34,197,94,0.4);color:var(--green);}
.toast.err{border-color:rgba(239,68,68,0.4);color:var(--red);}
@keyframes fadeIn{from{opacity:0;transform:translateX(-50%) translateY(8px);}to{opacity:1;transform:translateX(-50%) translateY(0);}}
.loading{text-align:center;padding:40px;color:var(--text-muted);}
#graph-container{width:100%;height:calc(100vh - 180px);background:var(--bg);border:1px solid var(--border);border-radius:10px;position:relative;}
.graph-controls{display:flex;gap:8px;margin-bottom:12px;align-items:center;flex-wrap:wrap;}
.graph-legend{display:flex;gap:12px;font-size:11px;color:var(--text-dim);flex-wrap:wrap;}
.graph-legend-item{display:flex;align-items:center;gap:4px;}
.graph-legend-dot{width:10px;height:10px;border-radius:50%;}
.graph-info{position:absolute;bottom:12px;left:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:12px 16px;font-size:12px;max-width:300px;z-index:10;display:none;}
.graph-info-name{font-weight:600;color:var(--rose);font-size:14px;margin-bottom:4px;}
.graph-info-detail{color:var(--text-dim);margin:2px 0;}
@media(max-width:900px){
  .topbar-nav{display:none;}.hamburger{display:block;}
  .sidebar{position:fixed;top:0;left:0;bottom:0;width:280px;transform:translateX(-100%);transition:transform .25s;z-index:100;box-shadow:4px 0 20px rgba(0,0,0,0.5);}
  .sidebar.open{transform:translateX(0);}.sidebar-nav-mobile{display:block;}
  .main{padding:16px;}.table-wrap{display:none;}.card-list{display:flex;}.mobile-sort{display:flex;}
  .detail-grid{grid-template-columns:1fr;}.detail-header{flex-direction:column;}
  .form-grid{grid-template-columns:1fr;}
  .detail-actions .btn{flex:1;text-align:center;padding:10px;}
}
</style>
</head>
<body>
<div class="topbar">
  <div class="topbar-left">
    <button class="hamburger" onclick="toggleSidebar()">☰</button>
    <div class="topbar-logo">MYTHOS</div>
    <nav class="topbar-nav">
      <a href="/app/">Home</a><a href="/app/finance/">Finance</a>
      <a href="/app/people/" class="active">People</a><a href="/app/ontology/">Ontology</a>
    <a href="/app/quotes/">Quotes</a>
      <a href="/app/system/">System</a><a href="/app/sessions/">Sessions</a><a href="/app/registry/">Registry</a>
    </nav>
  </div>
  <div class="topbar-right"><span class="user-info" id="user-info"></span><a href="/auth/logout" class="logout-btn">logout</a></div>
</div>
<div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>
<div class="app-body">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-nav-mobile">
      <a href="/app/">Home</a><a href="/app/finance/">Finance</a><a href="/app/people/" class="active">People</a>
      <a href="/app/ontology/">Ontology</a>
    <a href="/app/quotes/">Quotes</a><a href="/app/system/">System</a><a href="/app/sessions/">Sessions</a><a href="/app/registry/">Registry</a>
    </div>
    <hr class="sidebar-divider" style="display:none" id="mobile-nav-divider">
    <div class="sidebar-section">
      <div class="sidebar-label">Views</div>
      <button class="sidebar-item active" onclick="filterType(null)" id="nav-all"><span class="icon">👤</span> All People <span class="sidebar-count" id="count-all">—</span></button>
      <button class="sidebar-item" onclick="filterType('person')" id="nav-person"><span class="icon">✦</span> Canonical <span class="sidebar-count" id="count-canonical">—</span></button>
      <button class="sidebar-item" onclick="filterType('entity')" id="nav-entity"><span class="icon">◈</span> Aspects <span class="sidebar-count" id="count-entity">—</span></button>
      <button class="sidebar-item" onclick="filterType('soul')" id="nav-soul"><span class="icon">☀</span> Souls <span class="sidebar-count" id="count-soul">—</span></button>
      <button class="sidebar-item" onclick="filterType('genealogy')" id="nav-genealogy"><span class="icon">🌳</span> Genealogy <span class="sidebar-count" id="count-genealogy">—</span></button>
    </div>
    <hr class="sidebar-divider">
    <div class="sidebar-section">
      <button class="sidebar-item" onclick="showSection('graph')" id="nav-graph"><span class="icon">◉</span> Graph View</button>
      <button class="sidebar-item" onclick="showSection('add')" id="nav-add"><span class="icon">＋</span> Add Person</button>
    </div>
    <hr class="sidebar-divider">
    <div class="sidebar-section">
      <div class="sidebar-label">Stats</div>
      <div style="padding:4px 10px;font-size:12px;color:var(--text-muted);">
        <div style="display:flex;justify-content:space-between;margin:4px 0;"><span>With DOB</span><span id="stat-dob" style="font-family:'JetBrains Mono',monospace;color:var(--text-dim);">—</span></div>
        <div style="display:flex;justify-content:space-between;margin:4px 0;"><span>Deceased</span><span id="stat-deceased" style="font-family:'JetBrains Mono',monospace;color:var(--text-dim);">—</span></div>
      </div>
    </div>
  </nav>
  <div class="main" id="main"><div class="loading">Loading...</div></div>
</div>
<div class="toast" id="toast"></div>
<script>
const TYPE_COLORS={person:'#06b6d4',entity:'#a855f7',soul:'#d4a574',soul_person:'#d4a574',genealogy:'#f59e0b',incarnation:'#22c55e',alias:'#64748b',lineage:'#f43f5e'};
const TYPE_LABELS={person:'Person',entity:'Aspect',soul:'Soul',soul_person:'Soul',genealogy:'Gen'};
const PERSON_TYPES=['Family','Personal','Contact','Business','School','Religious','Historical','Spiritual','Musical','Political','Literary','Scientific','Mythological'];
let allPeople=[],allRelTypes=[],currentSort='name',currentOrder='asc',currentSection='directory',currentFilter=null,editingPerson=null,sidebarOpen=false,cyInstance=null;

function toggleSidebar(){sidebarOpen=!sidebarOpen;document.getElementById('sidebar').classList.toggle('open',sidebarOpen);document.getElementById('sidebar-overlay').classList.toggle('open',sidebarOpen);}
function closeSidebar(){sidebarOpen=false;document.getElementById('sidebar').classList.remove('open');document.getElementById('sidebar-overlay').classList.remove('open');}
fetch('/auth/me').then(r=>{if(!r.ok)throw'a';return r.json()}).then(d=>{document.getElementById('user-info').textContent=d.name||d.email}).catch(()=>{window.location.href='/app/login'});
loadStats();loadPeople();loadRelTypes();

async function loadStats(){try{const r=await fetch('/api/people/stats');const d=await r.json();document.getElementById('count-all').textContent=d.total-d.genealogy;document.getElementById('count-canonical').textContent=d.canonical;document.getElementById('count-entity').textContent=d.entities;document.getElementById('count-soul').textContent=d.souls;document.getElementById('count-genealogy').textContent=d.genealogy;document.getElementById('stat-dob').textContent=d.with_dob;document.getElementById('stat-deceased').textContent=d.deceased;}catch(e){}}
async function loadRelTypes(){try{const r=await fetch('/api/people/rel-types');const d=await r.json();allRelTypes=d.types.map(t=>t.type);}catch(e){}}
async function loadPeople(search){try{let url=`/api/people/?sort=${currentSort}&order=${currentOrder}&limit=500`;if(currentFilter)url+=`&node_type=${currentFilter}`;if(search)url+=`&search=${encodeURIComponent(search)}`;const r=await fetch(url);const d=await r.json();allPeople=d.people;if(currentSection==='directory')renderDirectory();}catch(e){document.getElementById('main').innerHTML='<div class="empty">Failed to load</div>';}}

function filterType(type){currentFilter=type;currentSection='directory';document.querySelectorAll('.sidebar-item').forEach(el=>el.classList.remove('active'));(document.getElementById('nav-'+(type||'all'))||{}).classList?.add('active');closeSidebar();loadPeople(document.getElementById('search-input')?.value);}
function showSection(s){currentSection=s;document.querySelectorAll('.sidebar-item').forEach(el=>el.classList.remove('active'));const n=document.getElementById('nav-'+s);if(n)n.classList.add('active');closeSidebar();if(s==='directory')renderDirectory();else if(s==='add')renderAddForm();else if(s==='graph')renderGraph();}
function showDetail(eid){currentSection='detail';closeSidebar();renderDetail(eid);}

// Helpers
function esc(s){if(!s)return'';const d=document.createElement('div');d.textContent=String(s);return d.innerHTML;}
function pName(p){return p.display_name||p.full_name||p.name||p.given_name||p.spiritual_name||'Unknown';}
function pBirth(p){return p.birth_date?String(p.birth_date).substring(0,10):null;}
function pLoc(p){return p.birth_location||p.birth_place||p.current_location||p.residence||'';}
function pDesc(p){return p.description||p.notes||p.primary_role||'';}
function typeBadge(t){return`<span class="badge badge-${t}">${TYPE_LABELS[t]||t}</span>`;}
function calcAge(dob,dod){if(!dob)return null;const b=new Date(String(dob).substring(0,10)+'T00:00:00');const e=dod?new Date(String(dod).substring(0,10)+'T00:00:00'):new Date();let a=e.getFullYear()-b.getFullYear();const m=e.getMonth()-b.getMonth();if(m<0||(m===0&&e.getDate()<b.getDate()))a--;return a>=0?a:null;}
function fmtD(iso){if(!iso)return'—';const s=String(iso).substring(0,10);try{return new Date(s+'T00:00:00').toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});}catch(e){return s;}}
function sa(f){return currentSort!==f?'':currentOrder==='asc'?'↑':'↓';}
function sortBy(f){if(currentSort===f)currentOrder=currentOrder==='asc'?'desc':'asc';else{currentSort=f;currentOrder='asc';}loadPeople(document.getElementById('search-input')?.value);}
let st=null;function debounceSearch(v){clearTimeout(st);st=setTimeout(()=>loadPeople(v),250);}
function toast(msg,type){const el=document.getElementById('toast');el.textContent=msg;el.className='toast '+(type||'');el.style.display='block';setTimeout(()=>{el.style.display='none';},3000);}
function classify(labels){const s=new Set(labels);if(s.has('Soul')&&s.has('Person'))return'soul_person';if(s.has('Soul'))return'soul';if(s.has('GenPerson'))return'genealogy';if(s.has('Entity'))return'entity';if(s.has('Incarnation'))return'incarnation';if(s.has('Alias'))return'alias';if(s.has('Lineage'))return'lineage';return'person';}
function fr(label,value,cls){const vc=value?(cls?`field-value ${cls}`:'field-value'):'field-value empty-val';return`<div class="field-row"><span class="field-label">${label}</span><span class="${vc}">${value?esc(String(value)):'—'}</span></div>`;}

// ── Directory ──
function renderDirectory(){
  const main=document.getElementById('main');
  let h=`<div class="search-bar"><input type="text" class="search-input" id="search-input" placeholder="Search people..." oninput="debounceSearch(this.value)"><button class="btn btn-primary" onclick="showSection('add')">＋ Add</button></div>`;
  h+=`<div class="table-wrap"><div class="table-scroll"><table><thead><tr>
    <th></th><th class="${currentSort==='name'?'sorted':''}" onclick="sortBy('name')">Name ${sa('name')}</th>
    <th class="${currentSort==='person_type'?'sorted':''}" onclick="sortBy('person_type')">Type ${sa('person_type')}</th>
    <th class="${currentSort==='birth_date'?'sorted':''}" onclick="sortBy('birth_date')">Born ${sa('birth_date')}</th>
    <th>Location</th><th>Info</th></tr></thead><tbody>`;
  if(!allPeople.length)h+='<tr><td colspan="6"><div class="empty">No people found</div></td></tr>';
  else for(const p of allPeople){
    const nm=esc(pName(p));const bd=pBirth(p);const age=calcAge(p.birth_date,p.death_date);
    const loc=esc(pLoc(p));const desc=pDesc(p);const nt=desc?esc(desc.substring(0,60))+(desc.length>60?'…':''):'';
    const aliases=(p._aliases||[]).slice(0,3).map(a=>esc(a)).join(', ');
    const pt=p.person_type?`<span class="badge-ptype">${esc(p.person_type)}</span>`:'';
    h+=`<tr onclick="showDetail('${p._element_id}')"><td>${typeBadge(p._type)}</td>
      <td><div class="name-main">${nm}</div>${aliases?`<div class="name-sub">${aliases}</div>`:''}</td>
      <td>${pt}</td><td class="date-cell">${bd?fmtD(bd):'—'}${age!==null?`<div class="name-sub">Age ${age}</div>`:''}</td>
      <td class="loc-cell">${loc||'—'}</td><td class="notes-cell">${nt||'—'}</td></tr>`;
  }
  h+='</tbody></table></div></div>';
  // Mobile cards
  h+='<div class="card-list">';
  if(!allPeople.length)h+='<div class="empty">No people found</div>';
  else for(const p of allPeople){const nm=esc(pName(p));const age=calcAge(p.birth_date,p.death_date);const as=age!==null?(p.death_date?`${age}·dec`:`Age ${age}`):'';const loc=pLoc(p);const bd=pBirth(p);const meta=[bd?fmtD(bd):null,loc].filter(Boolean).join(' · ');
    h+=`<div class="person-card" onclick="showDetail('${p._element_id}')"><div class="person-card-top"><div class="person-card-name">${typeBadge(p._type)} ${nm} ${p.person_type?`<span class="badge-ptype">${esc(p.person_type)}</span>`:''}</div>${as?`<div class="person-card-age">${as}</div>`:''}</div>${meta?`<div class="person-card-meta">${esc(meta)}</div>`:''}</div>`;}
  h+='</div>';main.innerHTML=h;
}

// ── Detail ──
async function renderDetail(eid){
  const main=document.getElementById('main');main.innerHTML='<div class="loading">Loading...</div>';
  try{const r=await fetch(`/api/people/${encodeURIComponent(eid)}`);if(!r.ok)throw'x';const p=await r.json();editingPerson=p;renderDetailView(p);}catch(e){main.innerHTML='<div class="empty">Not found</div>';}
}
function renderDetailView(p){
  const main=document.getElementById('main');const name=pName(p);const age=calcAge(p.birth_date,p.death_date);const eid=p._element_id;
  let h=`<button class="detail-back" onclick="showSection('directory')">← Back</button>
    <div class="detail-header"><div><div class="detail-name">${esc(name)}</div>
    <div class="detail-sub">${typeBadge(p._type)} ${p.person_type?`<span class="badge-ptype">${esc(p.person_type)}</span>`:''}
      ${p.canonical_id?`<span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-muted)">${esc(p.canonical_id)}</span>`:''}
      ${age!==null?`<span>· Age ${age}</span>`:''} ${p.death_date?'<span>· Deceased</span>':''}</div></div>
    <div class="detail-actions"><button class="btn btn-graph" onclick="renderEgoGraph('${eid}')">◉ Graph</button>
      <button class="btn btn-primary" onclick="startEdit()">✎ Edit</button>
      <button class="btn btn-danger" onclick="confirmDelete('${eid}','${esc(name).replace(/'/g,"\\'")}')">✕</button></div></div>`;
  if(p._aliases&&p._aliases.length)h+=`<div style="margin-bottom:16px"><div class="alias-list">${p._aliases.map(a=>`<span class="alias-tag">${esc(a)}</span>`).join('')}</div></div>`;
  h+='<div class="detail-grid"><div class="field-group"><div class="field-group-title">Identity</div>';
  [['full_name','Full Name'],['display_name','Display Name'],['name','Name'],['given_name','Given Name'],['surname','Surname'],['spiritual_name','Spiritual Name'],['primary_role','Primary Role'],['person_type','Person Type'],['gender','Gender'],['sex','Sex'],['nationality','Nationality']].forEach(([k,l])=>{if(p[k])h+=fr(l,p[k]);});
  h+='</div><div class="field-group"><div class="field-group-title">Birth / Death</div>';
  h+=fr('Birth Date',pBirth(p),'mono');
  ['birth_time','birth_location','birth_place','current_location','residence'].forEach(k=>{if(p[k])h+=fr(k.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase()),p[k]);});
  if(p.death_date)h+=fr('Death Date',String(p.death_date).substring(0,10),'mono');
  ['death_location','death_place','burial_place'].forEach(k=>{if(p[k])h+=fr(k.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase()),p[k]);});
  h+='</div></div>';
  const desc=p.description||p.notes||p.primary_role;
  if(desc)h+=`<div class="notes-section"><div class="field-group-title">Description</div><div class="notes-text">${esc(desc)}</div></div>`;
  // Soul data
  const sf=['spiritual_titles','spiritual_roles','known_for','lineage_claims','children','also_known_as','partnership'];
  if(sf.some(f=>p[f])){h+=`<div class="notes-section"><div class="field-group-title">Soul Data</div>`;sf.forEach(f=>{if(!p[f])return;const l=f.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());const v=Array.isArray(p[f])?p[f].join(', '):String(p[f]);h+=`<div class="field-row"><span class="field-label">${l}</span><span class="field-value">${esc(v)}</span></div>`;});h+='</div>';}
  // Relationships
  const rels=p._relationships||[];
  h+=`<div class="rel-section"><div class="field-group-title">Relationships (${rels.length}) <button class="btn" style="font-size:11px;padding:3px 8px" onclick="toggleRelAdd()">＋ Add</button></div>`;
  for(const r of rels){const arrow=r.direction==='outgoing'?'→':'←';const ps=Object.entries(r.properties||{}).filter(([k])=>k!=='created_at').map(([k,v])=>`${k}:${v}`).join(' ');
    h+=`<div class="rel-item"><span class="rel-type">${esc(r.type)}</span><span class="rel-dir">${arrow}</span>
      <a class="rel-target" onclick="showDetail('${r.target_eid}')">${esc(r.target_name||r.target_canonical||'?')}</a>
      ${r.target_labels?typeBadge(classify(r.target_labels)):''}${ps?`<span class="rel-props">${esc(ps)}</span>`:''}
      <span class="rel-delete" onclick="event.stopPropagation();deleteRel('${eid}','${r.target_eid}','${r.type}')" title="Delete">✕</span></div>`;}
  // Add relationship form (hidden by default)
  h+=`<div id="rel-add-panel" style="display:none"><div class="rel-add-form">
    <div style="position:relative"><input id="rel-target-search" placeholder="Search target..." oninput="searchRelTarget(this.value)" autocomplete="off" style="width:250px">
    <div id="rel-search-results" class="rel-search-results" style="display:none"></div></div>
    <select id="rel-type-select" style="width:180px"><option value="">Relationship type...</option>${allRelTypes.map(t=>`<option value="${t}">${t}</option>`).join('')}<option value="__custom">Custom...</option></select>
    <input id="rel-custom-type" placeholder="CUSTOM_TYPE" style="display:none;width:150px">
    <button class="btn btn-save" style="padding:5px 12px" onclick="addRel('${eid}')">Add</button></div></div>`;
  h+='</div>';
  h+=`<div class="detail-meta">elementId: ${esc(eid)}${p.created_at?' · Created: '+esc(String(p.created_at).substring(0,19)):''}</div>`;
  main.innerHTML=h;
  document.getElementById('rel-type-select')?.addEventListener('change',function(){document.getElementById('rel-custom-type').style.display=this.value==='__custom'?'block':'none';});
}
function toggleRelAdd(){const p=document.getElementById('rel-add-panel');p.style.display=p.style.display==='none'?'block':'none';}
let relTargetEid=null;
async function searchRelTarget(q){
  const box=document.getElementById('rel-search-results');
  if(!q||q.length<2){box.style.display='none';return;}
  const r=await fetch(`/api/people/search-nodes?q=${encodeURIComponent(q)}`);const d=await r.json();
  if(!d.nodes.length){box.style.display='none';return;}
  box.innerHTML=d.nodes.map(n=>`<div class="rel-search-item" onclick="pickRelTarget('${n.eid}','${esc(n.name)}')">${typeBadge(n.type)} ${esc(n.name)} <span style="font-size:10px;color:var(--text-muted)">${esc(n.canonical_id||'')}</span></div>`).join('');
  box.style.display='block';
}
function pickRelTarget(eid,name){relTargetEid=eid;document.getElementById('rel-target-search').value=name;document.getElementById('rel-search-results').style.display='none';}
async function addRel(sourceEid){
  if(!relTargetEid){toast('Select a target','err');return;}
  let relType=document.getElementById('rel-type-select').value;
  if(relType==='__custom')relType=document.getElementById('rel-custom-type').value.trim();
  if(!relType){toast('Select relationship type','err');return;}
  try{const r=await fetch(`/api/people/${encodeURIComponent(sourceEid)}/rels`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({target_eid:relTargetEid,rel_type:relType})});
    if(!r.ok){const e=await r.json();throw e.detail||'Failed';}toast('Relationship created','ok');relTargetEid=null;renderDetail(sourceEid);}catch(e){toast(String(e),'err');}
}
async function deleteRel(sourceEid,targetEid,relType){
  if(!confirm(`Delete ${relType} relationship?`))return;
  try{const r=await fetch(`/api/people/${encodeURIComponent(sourceEid)}/rels`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({target_eid:targetEid,rel_type:relType})});
    if(!r.ok){const e=await r.json();throw e.detail||'Failed';}toast('Deleted','ok');renderDetail(sourceEid);}catch(e){toast(String(e),'err');}
}

// ── Edit ──
function startEdit(){
  const p=editingPerson;if(!p)return;const main=document.getElementById('main');
  const skip=new Set(['_element_id','_labels','_type','_aliases','_relationships','_rel_count']);
  const props=Object.entries(p).filter(([k])=>!skip.has(k)&&!Array.isArray(p[k])&&typeof p[k]!=='object');
  let h=`<button class="detail-back" onclick="renderDetailView(editingPerson)">← Cancel</button>
    <div style="margin-bottom:20px"><div class="detail-name" style="font-size:20px">Editing: ${esc(pName(p))}</div></div><div class="form-card"><div class="form-grid">`;
  // person_type dropdown
  h+=`<div class="form-field"><label class="form-label">Person Type</label><select class="form-select" id="edit-person_type"><option value="">— None —</option>${PERSON_TYPES.map(t=>`<option value="${t}"${p.person_type===t?' selected':''}>${t}</option>`).join('')}</select></div>`;
  for(const [k,v] of props){if(k==='person_type')continue;const label=k.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());const inputType=(k.includes('date')&&!k.includes('stratigraphy'))?'date':k.includes('time')&&k!=='birth_time_source'?'time':'text';
    h+=`<div class="form-field"><label class="form-label">${esc(label)}</label><input class="form-input" type="${inputType}" id="edit-${k}" value="${esc(String(v||''))}"></div>`;}
  h+=`</div><div class="form-actions"><button class="btn btn-save" onclick="saveEdit('${p._element_id}')">✓ Save</button><button class="btn" onclick="renderDetailView(editingPerson)">Cancel</button></div></div>`;
  main.innerHTML=h;
}
async function saveEdit(eid){
  const skip=new Set(['_element_id','_labels','_type','_aliases','_relationships','_rel_count']);const p=editingPerson;const body={};
  const known=['full_name','display_name','name','canonical_id','person_type','birth_date','birth_time','birth_location','birth_place','death_date','death_location','death_place','current_location','description','notes','given_name','surname','sex','spiritual_name','primary_role','gender','nationality','residence'];
  const extra={};
  // Handle person_type select
  const ptEl=document.getElementById('edit-person_type');
  if(ptEl){const v=ptEl.value||null;if(v!==(p.person_type||null)){body.person_type=v;}}
  for(const [k] of Object.entries(p).filter(([k])=>!skip.has(k)&&!Array.isArray(p[k])&&typeof p[k]!=='object'&&k!=='person_type')){
    const el=document.getElementById('edit-'+k);if(!el)continue;const v=el.value.trim()||null;if(v===String(p[k]||''))continue;
    if(known.includes(k))body[k]=v;else extra[k]=v;}
  if(Object.keys(extra).length)body.extra=extra;if(!Object.keys(body).length){toast('No changes','err');return;}
  try{const r=await fetch(`/api/people/${encodeURIComponent(eid)}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(!r.ok){const e=await r.json();throw e.detail||'Failed';}toast('Updated','ok');loadStats();loadPeople();renderDetail(eid);}catch(e){toast(String(e),'err');}
}

// ── Add ──
function renderAddForm(){
  const main=document.getElementById('main');
  main.innerHTML=`<div class="form-card"><div class="form-title">✦ Add Person</div><div class="form-grid">
    <div class="form-field"><label class="form-label">Full Name *</label><input class="form-input" id="add-full_name" placeholder="Full name"></div>
    <div class="form-field"><label class="form-label">Display Name</label><input class="form-input" id="add-display_name" placeholder="How to display"></div>
    <div class="form-field"><label class="form-label">Person Type</label><select class="form-select" id="add-person_type"><option value="">— None —</option>${PERSON_TYPES.map(t=>`<option value="${t}">${t}</option>`).join('')}</select></div>
    <div class="form-field"><label class="form-label">Canonical ID</label><input class="form-input" id="add-canonical_id" placeholder="Auto if blank"></div>
    <div class="form-field"><label class="form-label">Birth Date</label><input class="form-input" type="date" id="add-birth_date"></div>
    <div class="form-field"><label class="form-label">Birth Time</label><input class="form-input" type="time" id="add-birth_time"></div>
    <div class="form-field"><label class="form-label">Birth Location</label><input class="form-input" id="add-birth_location" placeholder="City, State"></div>
    <div class="form-field"><label class="form-label">Current Location</label><input class="form-input" id="add-current_location"></div>
    <div class="form-field"><label class="form-label">Death Date</label><input class="form-input" type="date" id="add-death_date"></div>
    <div class="form-field"></div>
    <div class="form-field full"><label class="form-label">Description</label><textarea class="form-textarea" id="add-description" placeholder="Roles, lineage, identity..."></textarea></div>
  </div><div class="form-actions"><button class="btn btn-save" onclick="submitAdd()">✓ Create</button><button class="btn" onclick="filterType(null)">Cancel</button></div></div>`;
}
async function submitAdd(){
  const b={};['full_name','display_name','canonical_id','birth_date','birth_time','birth_location','current_location','death_date'].forEach(f=>{const el=document.getElementById('add-'+f);if(el&&el.value.trim())b[f]=el.value.trim();});
  const pt=document.getElementById('add-person_type');if(pt&&pt.value)b.person_type=pt.value;
  const desc=document.getElementById('add-description');if(desc&&desc.value.trim())b.description=desc.value.trim();
  if(!b.full_name){toast('Full name required','err');return;}
  try{const r=await fetch('/api/people/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});
    if(!r.ok){const e=await r.json();throw e.detail||'Failed';}const c=await r.json();toast(`Created: ${pName(c)}`,'ok');loadStats();await loadPeople();showDetail(c._element_id);}catch(e){toast(String(e),'err');}
}

// ── Delete ──
function confirmDelete(eid,name){if(!confirm(`Delete "${name}"?`))return;doDelete(eid);}
async function doDelete(eid){try{const r=await fetch(`/api/people/${encodeURIComponent(eid)}?confirm=true`,{method:'DELETE'});if(!r.ok){const e=await r.json();throw e.detail||'Failed';}const d=await r.json();toast(`Deleted: ${d.name}`,'ok');editingPerson=null;loadStats();await loadPeople();filterType(currentFilter);}catch(e){toast(String(e),'err');}}

// ══════════════════════════════════════════
// GRAPH VISUALIZATION (Cytoscape.js)
// ══════════════════════════════════════════
async function renderGraph(){
  const main=document.getElementById('main');
  main.innerHTML=`<div class="graph-controls">
    <button class="btn${!currentFilter?' btn-primary':''}" onclick="loadGraph(null)">All</button>
    <button class="btn" onclick="loadGraph('person')">Canonical</button>
    <button class="btn" onclick="loadGraph('entity')">Aspects</button>
    <button class="btn" onclick="loadGraph('soul')">Souls</button>
    <div class="graph-legend">
      <div class="graph-legend-item"><div class="graph-legend-dot" style="background:#06b6d4"></div>Person</div>
      <div class="graph-legend-item"><div class="graph-legend-dot" style="background:#a855f7"></div>Aspect</div>
      <div class="graph-legend-item"><div class="graph-legend-dot" style="background:#d4a574"></div>Soul</div>
      <div class="graph-legend-item"><div class="graph-legend-dot" style="background:#f59e0b"></div>Genealogy</div>
    </div></div>
    <div id="graph-container"><div class="loading" style="padding-top:30vh">Loading graph...</div>
    <div class="graph-info" id="graph-info"></div></div>`;
  loadGraph(null);
}

async function loadGraph(type){
  try{
    let url='/api/people/graph?limit=200';if(type)url+=`&node_type=${type}`;
    const r=await fetch(url);const d=await r.json();buildGraph(d.nodes,d.edges);
  }catch(e){toast('Graph load failed','err');}
}

async function renderEgoGraph(eid){
  currentSection='ego-graph';
  const main=document.getElementById('main');
  main.innerHTML=`<button class="detail-back" onclick="renderDetail('${eid}')">← Back to detail</button>
    <div id="graph-container"><div class="loading" style="padding-top:30vh">Loading graph...</div>
    <div class="graph-info" id="graph-info"></div></div>`;
  try{const r=await fetch(`/api/people/${encodeURIComponent(eid)}/graph?depth=2`);const d=await r.json();buildGraph(d.nodes,d.edges,d.center);}catch(e){toast('Graph load failed','err');}
}

function buildGraph(nodes,edges,centerEid){
  const container=document.getElementById('graph-container');
  container.innerHTML='<div class="graph-info" id="graph-info"></div>';
  const elements=[];
  const nodeSet=new Set(nodes.map(n=>n.eid));
  for(const n of nodes){
    elements.push({data:{id:n.eid,label:n.name||'?',nodeType:n.type,personType:n.person_type,canonical:n.canonical_id,isCenter:n.is_center||n.eid===centerEid}});
  }
  for(const e of edges){
    if(nodeSet.has(e.source)&&nodeSet.has(e.target)){
      elements.push({data:{id:e.source+'->'+e.target+':'+e.type,source:e.source,target:e.target,label:e.type.replace(/_/g,' ')}});
    }
  }
  if(cyInstance){cyInstance.destroy();cyInstance=null;}
  cyInstance=cytoscape({
    container:container,
    elements:elements,
    style:[
      {selector:'node',style:{'label':'data(label)','text-valign':'bottom','text-halign':'center','font-size':'11px','font-family':'DM Sans, sans-serif','color':'#94a3b8','text-margin-y':6,'width':28,'height':28,'border-width':2,'border-color':'#1e293b','text-outline-color':'#0a0e17','text-outline-width':2,'text-max-width':'120px','text-wrap':'ellipsis'}},
      {selector:'node[nodeType="person"]',style:{'background-color':'#06b6d4','border-color':'#0891b2'}},
      {selector:'node[nodeType="entity"]',style:{'background-color':'#a855f7','border-color':'#9333ea'}},
      {selector:'node[nodeType="soul"]',style:{'background-color':'#d4a574','border-color':'#c2956a','shape':'diamond','width':32,'height':32}},
      {selector:'node[nodeType="soul_person"]',style:{'background-color':'#d4a574','border-color':'#c2956a','shape':'diamond','width':32,'height':32}},
      {selector:'node[nodeType="genealogy"]',style:{'background-color':'#f59e0b','border-color':'#d97706','width':20,'height':20,'font-size':'9px'}},
      {selector:'node[nodeType="incarnation"]',style:{'background-color':'#22c55e','border-color':'#16a34a','shape':'octagon'}},
      {selector:'node[nodeType="alias"]',style:{'background-color':'#64748b','border-color':'#475569','width':16,'height':16,'font-size':'9px'}},
      {selector:'node[nodeType="lineage"]',style:{'background-color':'#f43f5e','border-color':'#e11d48','shape':'triangle'}},
      {selector:'node[?isCenter]',style:{'width':44,'height':44,'border-width':3,'border-color':'#f43f5e','font-size':'14px','font-weight':'bold','color':'#f43f5e'}},
      {selector:'edge',style:{'width':1.5,'line-color':'#293548','target-arrow-color':'#293548','target-arrow-shape':'triangle','arrow-scale':0.7,'curve-style':'bezier','label':'data(label)','font-size':'8px','font-family':'JetBrains Mono, monospace','color':'#475569','text-rotation':'autorotate','text-outline-color':'#0a0e17','text-outline-width':1.5,'text-margin-y':-8}},
      {selector:'node:active',style:{'overlay-opacity':0}},
      {selector:':selected',style:{'border-color':'#f43f5e','border-width':3}},
    ],
    layout:{name:'cose',animate:true,animationDuration:800,nodeRepulsion:function(){return 8000;},idealEdgeLength:function(){return 80;},gravity:0.3,numIter:300,padding:40},
    minZoom:0.2,maxZoom:4,wheelSensitivity:0.3,
  });
  // Click handler
  cyInstance.on('tap','node',function(evt){
    const d=evt.target.data();const info=document.getElementById('graph-info');
    info.innerHTML=`<div class="graph-info-name">${esc(d.label)}</div>
      <div class="graph-info-detail">${typeBadge(d.nodeType)} ${d.personType?`<span class="badge-ptype">${esc(d.personType)}</span>`:''}</div>
      ${d.canonical?`<div class="graph-info-detail" style="font-family:'JetBrains Mono',monospace;font-size:11px">${esc(d.canonical)}</div>`:''}
      <div style="margin-top:8px"><button class="btn btn-primary" style="font-size:11px;padding:4px 10px" onclick="showDetail('${d.id}')">Open Detail</button></div>`;
    info.style.display='block';
  });
  cyInstance.on('tap',function(evt){if(evt.target===cyInstance)document.getElementById('graph-info').style.display='none';});
}
</script>
</body>
</html>
